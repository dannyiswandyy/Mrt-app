                      return c.getPackageManager().getPackageInfo(c.getPackageName(), 0).versionName;
                  } catch (Exception e) {
                      return "";
                  }
              }

              /** Newer version info if one is available, otherwise null. */
              static JSONObject newer(Context c) {
                  JSONObject j = latest();
                  if (j == null) return null;
