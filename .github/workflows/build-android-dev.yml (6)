              def special(ln):
                  """Runs headed somewhere other than the end of the line (special-bound trains). Not counted on
                  loops, where most runs are headed back round to where they started."""
                  if ln in ("CCL", "BP", "SE", "SW", "PE", "PW"):
                      return "–"
