              files = sorted(x.split("/")[-1] for x in z.namelist())
              say("Files: " + ", ".join(f"`{f}`" for f in files))
              say("")
              say("<details><summary>First lines of each file</summary>\n")
              for n in z.namelist():
                  if n.endswith(".txt"):
