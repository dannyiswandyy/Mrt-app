          # ---------- reading an OpenBVE train ----------
          def ifind(base, rel):
              """The file at rel under base, matching names whatever their case ('sound\\Motor1.wav' finds sounds/motor1.WAV)."""
              cur = base
              for part in [p for p in re.split(r"[\\/]+", rel.strip()) if p and p != "."]:
                  if part == ".." or not os.path.isdir(cur):
                      return None
                  hit = next((n for n in sorted(os.listdir(cur)) if n.lower() == part.lower()), None)
                  if hit is None:
                      return None
                  cur = os.path.join(cur, hit)
              return cur if os.path.isfile(cur) else None


          def read_text(path):
              raw = open(path, "rb").read()
              for enc in ("utf-8-sig", "cp1252", "latin-1"):
                  try:
                      return raw.decode(enc)
                  except UnicodeDecodeError:
                      pass
              return raw.decode("utf-8", "replace")


          def parse_cfg(path):
              """sound.cfg: {section: {key: value}}, sections and keys in lower case."""
              out, sec = {}, None
              for line in read_text(path).splitlines():
                  s = line.split(";")[0].strip()
                  if not s:
                      continue
                  m = re.match(r"^\[(.+)\]$", s)
                  if m:
                      sec = m.group(1).strip().lower()
                      out.setdefault(sec, {})
                  elif sec is not None and "=" in s:
                      k, v = s.split("=", 1)
                      if v.strip():
                          out[sec][re.sub(r"\s+", " ", k.strip().lower())] = v.strip()
              return out


          def parse_tables(path):
              """train.dat's #MOTOR_P1/P2/B1/B2 rows: (sound index, pitch %, volume /128) every 0.2 km/h."""
              tables, sec = {}, None
              for line in read_text(path).splitlines():
                  s = line.split(";")[0].strip()
                  if not s:
                      continue
                  if s.startswith("#"):
                      k = s.lower()
                      sec = {"#motor_p1": "p1", "#motor_p2": "p2", "#motor_b1": "b1", "#motor_b2": "b2"}.get(k)
                      if sec:
                          tables[sec] = []
                      continue
                  if sec and len(tables[sec]) <= TOP_ROW:
                      vals = [x.strip() for x in s.split(",")]
                      def num(i, d):
                          try:
                              return float(vals[i]) if i < len(vals) and vals[i] else d
                          except ValueError:
                              return d
                      idx = num(0, -1)
                      tables[sec].append((int(round(idx)) if idx >= 0 else -1, max(0.0, num(1, 100)), max(0.0, num(2, 128))))
              return tables


          def simplify(rows):
              """The table as the points where it changes: [row, index, pitch, volume], straight lines between points of the same index."""
              out, i = [], 0
              while i < len(rows):
                  j = i
                  while j + 1 < len(rows) and rows[j + 1][0] == rows[i][0]:
                      j += 1
                  keep, stack = {i, j}, [(i, j)]
                  while stack:          # Douglas-Peucker on pitch and volume
                      a, b = stack.pop()
                      worst, at = 0, None
                      for k in range(a + 1, b):
                          t = (k - a) / (b - a)
                          e = max(abs(rows[a][1] + (rows[b][1] - rows[a][1]) * t - rows[k][1]) / 0.25,
                                  abs(rows[a][2] + (rows[b][2] - rows[a][2]) * t - rows[k][2]) / 0.25)
                          if e > worst:
                              worst, at = e, k
                      if worst > 1:
                          keep.add(at)
                          stack += [(a, at), (at, b)]
                  out += [[k, rows[k][0], round(rows[k][1], 2), round(rows[k][2], 2)] for k in sorted(keep)]
                  i = j + 1
              return out


          def max_db(ff, path):
              r = run([ff, "-nostdin", "-hide_banner", "-i", path, "-af", "volumedetect", "-f", "null", "-"], timeout=120)
              m = re.search(r"max_volume:\s*(-?[\d.]+|-inf) dB", r.stderr.decode("utf-8", "replace"))
              return -999.0 if not m or m.group(1) == "-inf" else float(m.group(1))


          def convert(ff, codec, src, files_dir):
              """One sound as a small mono file in files_dir, named by its content; returns the name, or None if it's silent."""
              if max_db(ff, src) < -50:
                  return None
              raw = open(src, "rb").read()
              ext = ".wav" if codec == "pcm" else ".ogg"
              name = hashlib.sha1(raw).hexdigest()[:12] + ext
              dest = os.path.join(files_dir, name)
              if not os.path.exists(dest):
                  enc = {"libvorbis": ["-c:a", "libvorbis", "-q:a", "4"], "libopus": ["-c:a", "libopus", "-b:a", "64k"],
                         "pcm": ["-c:a", "pcm_s16le"]}[codec]
                  tmp = dest + ".part"
                  r = run([ff, "-nostdin", "-v", "error", "-y", "-i", src, "-map", "0:a:0", "-ac", "1", *enc, "-map_metadata", "-1",
                           "-f", "wav" if codec == "pcm" else "ogg", tmp], timeout=180)
                  if r.returncode != 0 or not os.path.exists(tmp) or os.path.getsize(tmp) < 100:
                      raise RuntimeError(f"ffmpeg couldn't convert {os.path.basename(src)}")
                  os.replace(tmp, dest)
              return name


          def build_train(model, url, ver, ff, codec, sz, files_dir):
              work = tempfile.mkdtemp(prefix="obve-")
              try:
                  archive = os.path.join(work, "train.7z")
                  size = get(url, archive)
                  unpack(archive, os.path.join(work, "x"), sz)
                  os.remove(archive)
                  home = None
                  for d, _, fs in os.walk(os.path.join(work, "x")):
                      low = {f.lower() for f in fs}
                      if "train.dat" in low and "sound.cfg" in low:
                          home = d
                          break
                  if not home:
                      raise RuntimeError("no train.dat and sound.cfg in it")
                  cfg = parse_cfg(ifind(home, "sound.cfg"))
                  tables = {k: simplify(v) for k, v in parse_tables(ifind(home, "train.dat")).items() if v}
                  made = {}

                  def sound(rel):
                      if not rel:
                          return None
                      p = ifind(home, rel)
                      if not p or VOICE.search(os.path.basename(p)) or not p.lower().endswith((".wav", ".ogg", ".flac", ".mp3")):
                          return None
                      if p not in made:
                          made[p] = convert(ff, codec, p, files_dir)
                      return made[p]

                  def first(section, *keys):
                      sec = cfg.get(section, {})
                      for k in keys:
                          f = sound(sec.get(k))
                          if f:
                              return f
                      return None

                  def by_name(*stems):        # cab alarm sounds the train's safety system plays, found by file name
                      folders = {os.path.dirname(ifind(home, v) or "") for v in cfg.get("motor", {}).values()} - {""}
                      for folder in sorted(folders):
                          for n in sorted(os.listdir(folder)):
                              if os.path.splitext(n)[0].lower() in stems:
                                  f = sound(os.path.relpath(os.path.join(folder, n), home))
                                  if f:
                                      return f
                      return None

                  motor = {}
                  for k, v in cfg.get("motor", {}).items():
                      if k.isdigit():
                          f = sound(v)
                          if f:
                              motor[k] = f
                  used = {str(r[1]) for t in tables.values() for r in t if r[1] >= 0}
                  if not motor or not used & set(motor):
                      raise RuntimeError("no motor sounds")
                  runs = cfg.get("run", {})
                  # SMRTOSG's lines play run sound 1 on their main tracks (Train.Run(1).Set 1)
                  run_key = "1" if "1" in runs else "0" if "0" in runs else min(runs, key=lambda k: int(k) if k.isdigit() else 99, default=None)
                  horn_sec = cfg.get("horn", {})
                  e = {"name": os.path.basename(home), "ver": ver, "url": url, "motor": motor, "tables": tables,
                       "run": sound(runs.get(run_key)) if run_key else None,
                       "flange": first("flange", "0", *sorted(cfg.get("flange", {}))),
                       "noise": first("others", "noise"), "shoe": first("others", "shoe"),
                       "release": first("brake", "bc release full", "bc release", "bc release high"),
                       "emergency": first("brake", "emergency"),
                       "horn": first("horn", "primaryloop", "primary"), "hornLoop": "primaryloop" in horn_sec and not horn_sec.get("primary"),
                       "doorOpen": first("door", "open left", "open right"), "doorClose": first("door", "close left", "close right"),
                       "mcUp": first("master controller", "up", "upfast"), "mcDown": first("master controller", "down", "downfast"),
                       "mcMin": first("master controller", "min"), "mcMax": first("master controller", "max"),
                       "bhApply": first("brake handle", "apply", "applyfast"), "bhRelease": first("brake handle", "release", "releasefast"),
                       "bhMin": first("brake handle", "min"), "bhMax": first("brake handle", "max"),
                       "correct": first("buzzer", "correct"), "lampOn": first("pilot lamp", "on"), "lampOff": first("pilot lamp", "off"),
                       "point": first("switch", "0") or first("point frontaxle", "0"),
                       "alarm": by_name("emgstop"), "warn": by_name("overspeed") or first("buzzer", "correct")}
                  e = {k: v for k, v in e.items() if v not in (None, "", {}, [])}
                  e["files"] = sorted({f for f in made.values() if f})
                  say(f"✅ {model}: {e['name']}{f' v{ver}' if ver else ''} ({size / 1e6:.0f} MB download), {len(e['files'])} sounds.")
                  return e
              finally:
                  shutil.rmtree(work, ignore_errors=True)


          def main():
              cache = CACHE or tempfile.mkdtemp(prefix="sound-cache-")
              files_dir = os.path.join(cache, "files")
              os.makedirs(files_dir, exist_ok=True)
              idx_path = os.path.join(cache, "index.json")
              try:
                  index = json.load(open(idx_path))
                  assert index.get("v") == 1
              except Exception:
                  index = {"v": 1, "trains": {}, "models": {}}
              have = lambda e: e and all(os.path.exists(os.path.join(files_dir, f)) for f in e.get("files", []))
              fresh, models, tools = False, {}, None
              for model, (url, ver) in newest().items():
                  saved = index["trains"].get(url)
                  if have(saved):
                      models[model] = saved
                      continue
                  try:
                      if tools is None:
                          tools = get_tools()
                          if not tools[0]:
                              say("⚠️ ffmpeg isn't available, so no sounds can be converted this time.")
                      if not tools[0]:
                          raise RuntimeError("no ffmpeg")
                      e = build_train(model, url, ver, tools[0], tools[1], tools[2], files_dir)
                      index["trains"][url] = e
                      index["models"][model] = url
                      models[model] = e
                      fresh = True
                  except Exception as ex:
                      old = index["trains"].get(index["models"].get(model, ""))
                      if have(old):
                          models[model] = old
                          say(f"⚠️ {model}: the newest train couldn't be used ({type(ex).__name__}: {ex}); keeping the one saved before.")
                      else:
                          say(f"⚠️ {model}: no sounds ({type(ex).__name__}: {ex}); the game makes its own for this train.")
              if fresh:
                  json.dump(index, open(idx_path, "w"), separators=(",", ":"))
                  if CACHE:
                      open(os.path.join(os.path.dirname(os.path.abspath(CACHE)), "sounds-fresh"), "w").write("sounds\n")
              if not models:
                  say("No train sounds this time: the Drive game makes its own.")
                  return
              os.makedirs(OUT, exist_ok=True)
              total = 0
              for f in sorted({f for e in models.values() for f in e["files"]}):
                  shutil.copyfile(os.path.join(files_dir, f), os.path.join(OUT, f))
                  total += os.path.getsize(os.path.join(OUT, f))
              json.dump({"v": 1, "at": time.strftime("%Y-%m-%d"), "src": CREDIT, "models": models},
                        open(os.path.join(OUT, "sounds.json"), "w"), separators=(",", ":"))
              say(f"Packed sounds for {', '.join(sorted(models))}: {total / 1e6:.1f} MB.")


          try:
              main()
          except Exception as e:
              say(f"⚠️ The train sounds step hit an error ({type(e).__name__}: {e}). The Drive game makes its own sounds.")
          finish()
          MRTAPP_EOF
          mkdir -p 'mrt-tracker-app/tools'
          cat > 'mrt-tracker-app/tools/build_timetable.py' <<'MRTAPP_EOF'
          """Download LTA's official train timetable (GTFS Schedule (Train), LTA DataMall) and pack it for the app.

          Runs on GitHub during every build:  python3 tools/build_timetable.py <app project folder> [saved copy]

          Writes app/src/main/assets/timetable.json, which the app uses for exact train times. If anything
          goes wrong (no connection, unexpected format) it writes no timetable and the app falls back to
          estimates, so the build never fails because of this step. A report of what matched is written to
          the GitHub job summary.

          With a saved copy (the workflow keeps one in the repository, data/lta-timetable.json), every good
          download is also saved there, and when LTA's download fails the last good timetable is packed instead,
          so every version of the app has LTA's timetable.

          timetable.json:
            feed:     {source, built, files}
            services: [[service_id, "1111100" (Mon..Sun), start "YYYYMMDD", end "YYYYMMDD"], ...]
            except:   {"YYYYMMDD": [[service index, 1 = added | 2 = removed], ...]}
            lines:    {NSL: {pats: [[first station index, step +1/-1, [arrive s], [depart s], destination index], ...],
                             trips: [[start s since midnight, pattern index, service index], ...]}, ...}
                      The destination is the station the trip is headed for (its headsign), so special-bound trains
                      that end partway along the line show where they end; -1 when it's simply where the run ends,
                      -2 for a full loop back to where it started.
          """
          import csv, hashlib, io, json, os, re, shutil, sys, time, urllib.request, zipfile

          ROOT = sys.argv[1] if len(sys.argv) > 1 else "."
          OUT = os.path.join(ROOT, "app/src/main/assets/timetable.json")
          SAVED = sys.argv[2] if len(sys.argv) > 2 else None
          LINES = json.load(open(os.path.join(ROOT, "tools/lines.json")))
          SUMMARY = os.environ.get("GITHUB_STEP_SUMMARY")
          API = "https://datamall2.mytransport.sg/ltaodataservice/GTFSScheduleTrain"
          report = []

          def say(line=""):
              print(line)
              report.append(line)

          def use_saved():
              """LTA's download didn't work: pack the last good timetable instead, if there is one."""
              if not SAVED or not os.path.exists(SAVED):
                  say("\nThere's no saved timetable to fall back on yet, so this version of the app uses estimates.")
                  return False
              try:
                  j = json.load(open(SAVED))
                  os.makedirs(os.path.dirname(OUT), exist_ok=True)
                  shutil.copyfile(SAVED, OUT)
                  ends = max((s[3] for s in j.get("services", [])), default="")
                  say(f"\n✅ Packed the last good timetable instead: downloaded {j['feed']['built']}, {len(j['lines'])} lines"
                      + (f", covering dates up to {ends[:4]}-{ends[4:6]}-{ends[6:]}" if ends and ends < "2999" else "") + ".")
                  if ends and ends < time.strftime("%Y%m%d"):
                      say("⚠️ That timetable's dates have passed, so the app uses estimates until LTA's download works again.")
                  return True
              except Exception as e:
                  say(f"\n⚠️ The saved timetable couldn't be read ({e}), so this version of the app uses estimates.")
                  return False

          def keep_copy(res):
              """Save a good download to the repository copy, unless it's the same timetable as last time."""
              if not SAVED:
                  return
              try:
                  strip = lambda j: json.dumps({k: v for k, v in j.items() if k != "feed"}, sort_keys=True)
                  old = json.load(open(SAVED)) if os.path.exists(SAVED) else None
                  if old and strip(old) == strip(json.loads(json.dumps(res))):
                      say("Same timetable as the saved copy.")
                      return
                  os.makedirs(os.path.dirname(SAVED) or ".", exist_ok=True)
                  shutil.copyfile(OUT, SAVED)
                  say("Saved a copy to the repository (data/lta-timetable.json), for any build where LTA's download fails.")
              except Exception as e:
                  say(f"⚠️ Couldn't keep a copy of the timetable ({e}).")

          def finish(ok):
              if not ok:
                  if os.path.exists(OUT):
                      os.remove(OUT)
                  use_saved()
              if SUMMARY:
                  with open(SUMMARY, "a") as f:
                      f.write("## LTA train timetable\n\n" + "\n".join(report) + "\n")
              sys.exit(0)

          # ---------- the LTA key (stored scrambled in app/build.gradle) ----------
          def lta_key():
              g = open(os.path.join(ROOT, "app/build.gradle")).read()
              m = re.search(r"LTA_KEY_X',\s*'\"([0-9a-f]+)\"'", g)
              if not m:
                  return ""
              mask = hashlib.sha256(b"sg.mrttracker.app").digest()
              hx = m.group(1)
              key = bytes(int(hx[i:i + 2], 16) ^ mask[(i // 2) % 32] for i in range(0, len(hx), 2)).decode()
              print("::add-mask::" + key)
              return key

          def http(url, headers=None, tries=3):
              for t in range(tries):
                  try:
                      req = urllib.request.Request(url, headers=headers or {})
                      with urllib.request.urlopen(req, timeout=60) as r:
                          return r.read()
                  except Exception as e:
                      if t == tries - 1:
                          raise
                      time.sleep(3 * (t + 1))

          def find_link(o):
              if isinstance(o, str):
                  return o if o.startswith("https://") and "gtfs" in o.lower() else None
              if isinstance(o, dict):
                  for k in ("Link", "link"):
                      if isinstance(o.get(k), str) and o[k].startswith("https://"):
                          return o[k]
                  o = list(o.values())
              if isinstance(o, list):
                  for v in o:
                      r = find_link(v)
                      if r:
                          return r
              return None

          # ---------- station matching ----------
          def norm(s):
              s = s.lower().replace("&", "and")
              s = re.sub(r"\([^)]*\)", " ", s)
              s = re.sub(r"\b(mrt|lrt)\b|\bstation\b|\binterchange\b|\bplatform\b.*$", " ", s)
              return re.sub(r"[^a-z0-9]", "", s)

          NAME_IDX, CODE_IDX = {}, {}         # normalised name / code -> [(line, index)]
          for line, L in LINES.items():
              for i, (code, name) in enumerate(L["stations"]):
                  NAME_IDX.setdefault(norm(name), []).append((line, i))
                  CODE_IDX.setdefault(code.upper(), []).append((line, i))
          CODE_ALIASES = {"CE1": "CC34", "CE2": "CC33"}
          CODE_RE = re.compile(r"\b(NS|EW|CG|NE|CC|CE|DT|TE|BP|SE|SW|PE|PW)\s?(\d{1,2})\b|\b(STC|PTC)\b", re.I)

          def stop_candidates(stop, stops):
              """All (line, index) this GTFS stop could be, from station codes first, then names."""
              texts = [stop.get("stop_code", ""), stop.get("stop_id", ""), stop.get("stop_name", "")]
              parent = stops.get(stop.get("parent_station") or "")
              if parent:
                  texts += [parent.get("stop_code", ""), parent.get("stop_id", ""), parent.get("stop_name", "")]
              found = []
              for t in texts:
                  for m in CODE_RE.finditer(t or ""):
                      code = (m.group(1) + m.group(2)).upper() if m.group(1) else m.group(3).upper()
                      code = CODE_ALIASES.get(code, code)
                      found += CODE_IDX.get(code, [])
              names = [parent.get("stop_name", "")] if parent else []
              names.append(stop.get("stop_name", ""))
              for n in names:
                  found += NAME_IDX.get(norm(n or ""), [])
              return sorted(set(found))

          MAX_STEP = 2      # stops next to each other on a trip are at most this far apart in the app's station list

          def legs_for(seq, line):
              """Split one trip's stops into runs that move one way along `line`. seq: [(cands_on_line, arr, dep)].
              A run also breaks where two stops in a row aren't neighbours in the app's list, such as where the
              Circle Line's loop joins (Promenade and Bayfront), so no run is drawn across the whole line."""
              legs, cur = [], None
              for cands, arr, dep in seq:
                  if cur is None:
                      cur = {"rows": [(cands, arr, dep)], "idx": [], "dir": 0}
                      continue
                  if not cur["idx"]:
                      prev = cur["rows"][-1][0]
                      pairs = [(abs(a - b), a, b) for a in prev for b in cands if a != b]
                      if not pairs or min(pairs)[0] > MAX_STEP:
                          cur = {"rows": [(cands, arr, dep)], "idx": [], "dir": 0}
                          continue
                      _, a, b = min(pairs)
                      cur["rows"] = [cur["rows"][-1], (cands, arr, dep)]
                      cur["idx"] = [a, b]
                      cur["dir"] = 1 if b > a else -1
                      continue
                  last, d = cur["idx"][-1], cur["dir"]
                  ahead = [x for x in cands if (x - last) * d > 0]
                  nxt = min(ahead, key=lambda x: abs(x - last)) if ahead else None
                  if nxt is not None and abs(nxt - last) <= MAX_STEP:
                      cur["rows"].append((cands, arr, dep))
                      cur["idx"].append(nxt)
                  else:                                   # the train turns (or jumps): start a new run from the last stop
                      legs.append(cur)
                      prow = cur["rows"][-1]
                      cur = {"rows": [prow], "idx": [], "dir": 0}
                      # a station can appear twice on a line (Bukit Panjang on the BP loop): pick the closest pair
                      pairs = [(abs(a - b), a, b) for a in prow[0] for b in cands if b != a]
                      if pairs and min(pairs)[0] <= MAX_STEP:
                          _, a, b = min(pairs)
                          cur["rows"].append((cands, arr, dep))
                          cur["idx"] = [a, b]
                          cur["dir"] = 1 if b > a else -1
                      else:
                          cur = {"rows": [(cands, arr, dep)], "idx": [], "dir": 0}
              if cur and cur["idx"]:
                  legs.append(cur)
              return legs

          def headsign_idx(trip, line, legs):
              """Where a trip is headed, as a station index on its line: the trip's headsign if it names a station
              on the line, else (for a trip that turns or wraps, so its runs end before it does) its last stop.
              -1: where each run ends. -2: a trip that goes round and back to where it started (a full loop)."""
              h = headsign_station(trip, line, legs)
              first = legs[0]["idx"][0]
              if len(legs) > 1 and h >= 0 and (h == first or LINES[line]["stations"][h][0] == LINES[line]["stations"][first][0]):
                  return -2
              return h

          def headsign_station(trip, line, legs):
              hs = (trip.get("trip_headsign") or "").strip()
              if hs:
                  hs = re.sub(r"^\s*(to|towards|for)\s+", "", hs, flags=re.I)
                  found = []
                  for m in CODE_RE.finditer(hs):
                      code = (m.group(1) + m.group(2)).upper() if m.group(1) else m.group(3).upper()
                      found += [i for l, i in CODE_IDX.get(CODE_ALIASES.get(code, code), []) if l == line]
                  if not found:
                      found = [i for l, i in NAME_IDX.get(norm(CODE_RE.sub(" ", hs)), []) if l == line]
                  if found:
                      last = legs[-1]["idx"][-1]
                      return min(found, key=lambda i: abs(i - last))       # a hub listed twice: the one nearest the trip's end
              return legs[-1]["idx"][-1] if len(legs) > 1 else -1

          def secs(t):
              h, m, s = (t or "").strip().split(":")
              return int(h) * 3600 + int(m) * 60 + int(s)

          def main():
              local = os.environ.get("MRT_GTFS_ZIP")      # for testing with a file instead of downloading
              if local:
                  data = open(local, "rb").read()
                  z = zipfile.ZipFile(io.BytesIO(data))
                  return process(z, data)
              key = lta_key()
              if not key:
                  say("⚠️ No LTA key found in the app, so the timetable was skipped.")
                  finish(False)
              try:
                  meta = http(API, {"AccountKey": key, "accept": "application/json"})
                  link = find_link(json.loads(meta))
                  if not link:
                      raise ValueError("LTA's reply had no download link: " + meta[:200].decode("utf-8", "replace"))
                  data = http(link)
