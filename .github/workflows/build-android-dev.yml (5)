          cat > 'mrt-tracker-app/tools/build_buildings.py' <<'MRTAPP_EOF'
          """Pack building outlines and heights around every station for the 3D buildings on the simple map.

          Runs on GitHub during every build:  python3 tools/build_buildings.py <app project folder> [cache folder]
          After a fresh download it also writes "osm-fresh" next to the cache folder, so the workflow saves the new copy.

          Buildings come from OpenStreetMap (data (c) OpenStreetMap contributors, ODbL), through the Overpass
          API. A copy is kept in the cache folder between builds, so OpenStreetMap is only asked again once a
          month, or when stations change. If the download fails, the last saved copy is used; with neither,
          the app simply shows no buildings. This step never fails the build.

          buildings.json:
            v: 1, src: attribution, at: "YYYY-MM-DD", r: radius in metres, q: metres per unit, key: station set
            b: [[height m, x, y, dx, dy, dx, dy, ...], ...]  outline in units of q, first point then steps,
               in the map's own metres (x east, y south of central Singapore), sorted north to south
          """
          import hashlib, json, math, os, re, shutil, sys, time, urllib.error, urllib.parse, urllib.request

          ROOT = sys.argv[1] if len(sys.argv) > 1 else "."
          CACHE = sys.argv[2] if len(sys.argv) > 2 else None
          ASSETS = os.path.join(ROOT, "app/src/main/assets")
          OUT = os.path.join(ASSETS, "buildings.json")
          SUMMARY = os.environ.get("GITHUB_STEP_SUMMARY")
          ENDPOINTS = [u for u in os.environ.get("OVERPASS_URLS", "").split() if u] or [
              "https://overpass-api.de/api/interpreter",
              "https://overpass.kumi.systems/api/interpreter",
              "https://maps.mail.ru/osm/tools/overpass/api/interpreter",
              "https://overpass.private.coffee/api/interpreter"]
          RADIUS = 400          # metres around each station
          Q = 0.5               # metres per stored unit
          BATCH = 12            # stations per Overpass request
          MAX_AGE_DAYS = 30
          DEADLINE = time.time() + float(os.environ.get("BUILDINGS_MAX_SECONDS", 8 * 60))   # stop asking after 8 minutes, so a slow day can't hold up the build
          LEVEL_M = 3.2
          # Same projection as the map (build_map.py): metres east and south of central Singapore.
          LAT0, LON0 = 1.3521, 103.8198
          KX, KY = 111320 * math.cos(math.radians(LAT0)), 110574
          # Typical heights in levels, for buildings without a height or level count.
          LEVELS = {"apartments": 12, "residential": 10, "hdb": 12, "dormitory": 8, "hotel": 15, "office": 10, "commercial": 6,
                    "retail": 3, "mall": 5, "hospital": 8, "school": 4, "university": 5, "college": 4, "public": 4, "civic": 4,
                    "government": 5, "industrial": 3, "warehouse": 3, "factory": 3, "train_station": 2, "transportation": 2,
                    "parking": 6, "multi-storey_car_park": 6, "garage": 1, "garages": 1, "house": 2, "detached": 2,
                    "semidetached_house": 2, "terrace": 2, "bungalow": 2, "church": 2, "mosque": 2, "temple": 2,
                    "religious": 2, "shed": 1, "hut": 1, "kiosk": 1, "service": 1, "carport": 1, "roof": 1, "toilets": 1}
          SKIP = {"no", "construction", "proposed", "demolished", "abandoned", "ruins", "bridge"}
          report = []


          def say(line=""):
              print(line)
              report.append(line)


          def finish():
              if SUMMARY:
                  with open(SUMMARY, "a") as f:
                      f.write("## 3D buildings\n\n" + "\n".join(report) + "\n")
              sys.exit(0)


          def station_points():
              """Station positions from the map data in the app's page, joined where they're close together."""
              html = open(os.path.join(ASSETS, "index.html"), encoding="utf-8").read()
              m = re.search(r'const MAP = \{"stations":(\{[^{}]*\})', html)
              pts = list(json.loads(m.group(1)).values())
              out = []
              for x, y in sorted(pts):
                  if not any(math.hypot(x - a, y - b) < 150 for a, b in out):
                      out.append((x, y))
              return out


          def to_latlon(x, y):
              return LAT0 - y / KY, LON0 + x / KX


          def to_xy(lat, lon):
              return (lon - LON0) * KX, -(lat - LAT0) * KY


          def overpass(points):
              parts = []
              for x, y in points:
                  lat, lon = to_latlon(x, y)
                  a = f"(around:{RADIUS},{lat:.6f},{lon:.6f})"
                  parts.append(f'way["building"]{a};relation["building"]["type"="multipolygon"]{a};')
              query = f"[out:json][timeout:180];({''.join(parts)});out tags geom qt;"
              data = urllib.parse.urlencode({"data": query}).encode()
              last = None
              for attempt in range(2):
                  for url in ENDPOINTS:
                      left = DEADLINE - time.time()
                      if left < 5:
                          raise RuntimeError("out of time")
                      try:
                          req = urllib.request.Request(url, data=data, headers={"User-Agent": "MRTTracker-build/1.0 (GitHub Actions; 3D station buildings)"})
                          with urllib.request.urlopen(req, timeout=min(200, left)) as r:
                              j = json.loads(r.read().decode("utf-8"))
                          if "elements" in j and not j.get("remark", "").lower().startswith("runtime error"):
                              return j["elements"]
                          last = j.get("remark", "no elements")
                      except Exception as e:
                          last = f"{type(e).__name__}: {e}"
                      time.sleep(3 + attempt * 7)
              raise RuntimeError(last)


          def num(v):
              m = re.match(r"^\s*(\d+(?:\.\d+)?)\s*(m|metres?|meters?|ft|feet|')?\s*$", str(v or ""), re.I)
              if not m:
                  return None
              n = float(m.group(1))
              return n * 0.3048 if m.group(2) and m.group(2).lower() in ("ft", "feet", "'") else n


          def height(tags):
              h = num(tags.get("height"))
              if h and 1 <= h <= 600:
                  return h
              lv = num(tags.get("building:levels"))
              if lv and 0 < lv <= 150:
                  return max(3.0, lv * LEVEL_M + (num(tags.get("roof:levels")) or 0) * LEVEL_M * 0.5)
              return LEVELS.get(tags.get("building", "yes"), 3) * LEVEL_M


          def simplify(pts, tol):
              if len(pts) < 4:
                  return pts
              keep = [False] * len(pts)
              keep[0] = keep[-1] = True
              stack = [(0, len(pts) - 1)]
              while stack:
                  a, b = stack.pop()
                  (x1, y1), (x2, y2) = pts[a], pts[b]
                  dx, dy = x2 - x1, y2 - y1
                  L = math.hypot(dx, dy) or 1e-9
                  best, bi = 0, -1
                  for i in range(a + 1, b):
                      d = abs((pts[i][0] - x1) * dy - (pts[i][1] - y1) * dx) / L
                      if d > best:
                          best, bi = d, i
                  if best > tol and bi > 0:
                      keep[bi] = True
                      stack += [(a, bi), (bi, b)]
              return [p for p, k in zip(pts, keep) if k]


          def simplify_ring(pts, tol):
              """Simplify a closed outline (first point not repeated): split it at the point farthest from
              the start and simplify each half, since both ends of a closed line are the same point."""
              if len(pts) < 5:
                  return pts
              far = max(range(len(pts)), key=lambda i: math.hypot(pts[i][0] - pts[0][0], pts[i][1] - pts[0][1]))
              a = simplify(pts[:far + 1], tol)
              b = simplify(pts[far:] + [pts[0]], tol)
              return a[:-1] + b[:-1]


          def area(pts):
              return abs(sum(pts[i][0] * pts[i - 1][1] - pts[i - 1][0] * pts[i][1] for i in range(len(pts)))) / 2


          def rings(el):
              """Outer rings of a building, as lists of (lat, lon)."""
              if el["type"] == "way":
                  g = el.get("geometry") or []
                  return [[(p["lat"], p["lon"]) for p in g if p]]
              segs = [[(p["lat"], p["lon"]) for p in m.get("geometry") or [] if p] for m in el.get("members", [])
                      if m.get("type") == "way" and m.get("role", "outer") in ("outer", "")]
              segs = [s for s in segs if len(s) >= 2]
              out = []
              while segs:
                  ring = segs.pop(0)
                  grew = True
                  while ring[0] != ring[-1] and grew:
                      grew = False
                      for i, s in enumerate(segs):
                          if s[0] == ring[-1]:
                              ring += s[1:]
                          elif s[-1] == ring[-1]:
                              ring += s[::-1][1:]
                          else:
                              continue
                          segs.pop(i)
                          grew = True
                          break
                  out.append(ring)
              return out


          def pack(elements):
              seen, out = set(), []
              for el in elements:
                  k = (el.get("type"), el.get("id"))
                  if k in seen:
                      continue
                  seen.add(k)
                  tags = el.get("tags") or {}
                  if tags.get("building", "yes") in SKIP or (tags.get("location") == "underground"):
                      continue
                  h = height(tags)
                  for ring in rings(el):
                      pts = [to_xy(lat, lon) for lat, lon in ring]
                      if len(pts) > 1 and pts[0] == pts[-1]:
                          pts = pts[:-1]
                      if len(pts) < 3 or area(pts) < 15:
                          continue
                      pts = simplify_ring(pts, 0.8)
                      if len(pts) < 3:
                          continue
                      u = [(round(x / Q), round(y / Q)) for x, y in pts]
                      flat = [int(round(min(h, 400)))] + list(u[0])
                      for (ax, ay), (bx, by) in zip(u, u[1:]):
                          flat += [bx - ax, by - ay]
                      out.append((sum(p[1] for p in pts) / len(pts), flat))
              out.sort(key=lambda t: t[0])
              return [f for _, f in out]


          def use(path, why):
              os.makedirs(ASSETS, exist_ok=True)
              shutil.copyfile(path, OUT)
              j = json.load(open(OUT))
              say(f"{why}: {len(j['b']):,} buildings from OpenStreetMap, downloaded {j['at']} ({os.path.getsize(OUT) / 1e6:.1f} MB).")


          def main():
              pts = station_points()
              key = hashlib.sha1(json.dumps([(round(x, -1), round(y, -1)) for x, y in pts]).encode()).hexdigest()[:12]
              cached = os.path.join(CACHE, "buildings.json") if CACHE else None
              old = None
              if cached and os.path.exists(cached):
                  try:
                      old = json.load(open(cached))
                  except Exception:
                      old = None
              if old and old.get("v") == 3 and old.get("key") == key and old.get("r") == RADIUS:
                  age = (time.time() - time.mktime(time.strptime(old["at"], "%Y-%m-%d"))) / 86400
                  if age < MAX_AGE_DAYS:
                      use(cached, "✅ Using the saved copy")
                      return
              say(f"Downloading buildings within {RADIUS} m of {len(pts)} station areas from OpenStreetMap…")
              elements, failed, in_a_row = [], 0, 0
              parts = math.ceil(len(pts) / BATCH)
              for n, i in enumerate(range(0, len(pts), BATCH)):
                  if in_a_row >= 2 or time.time() > DEADLINE:
                      failed += parts - n
                      say("⚠️ OpenStreetMap isn't answering, so the rest was skipped.")
                      break
                  try:
                      elements += overpass(pts[i:i + BATCH])
                      in_a_row = 0
                  except Exception as e:
                      failed += 1
                      in_a_row += 1
                      say(f"⚠️ Part {n + 1} of {parts} didn't download ({e}).")
                  time.sleep(2)
              if failed:
                  if old:
                      use(cached, f"⚠️ {failed} of {parts} parts didn't download, so the app keeps the saved copy")
                  else:
                      say(f"⚠️ {failed} of {parts} parts didn't download; no incomplete building set will be installed.")
                  return
              b = pack(elements)
              if not b:
                  if old:
                      use(cached, "⚠️ OpenStreetMap returned no buildings, so the app keeps the saved copy")
                  else:
                      say("⚠️ No buildings came back and there is no saved copy yet.")
                  return
              j = {"v": 3, "src": "© OpenStreetMap contributors", "at": time.strftime("%Y-%m-%d"), "r": RADIUS, "q": Q, "key": key, "b": b}
              os.makedirs(ASSETS, exist_ok=True)
              with open(OUT, "w") as f:
                  json.dump(j, f, separators=(",", ":"))
              if CACHE and not failed:
                  os.makedirs(CACHE, exist_ok=True)
                  shutil.copyfile(OUT, cached)
                  # tells the workflow there's a new copy worth saving for next time
                  open(os.path.join(os.path.dirname(os.path.abspath(CACHE)), "osm-fresh"), "w").write(j["at"])
              say(f"✅ {len(b):,} buildings packed ({os.path.getsize(OUT) / 1e6:.1f} MB)" + (f"; {failed} of {parts} parts missing, so some stations have no buildings." if failed else "."))


          if __name__ == "__main__":
              try:
                  main()
              except Exception as e:
                  say(f"⚠️ The buildings step hit an error ({type(e).__name__}: {e}). The map will show no buildings.")
              finish()
          MRTAPP_EOF
          mkdir -p 'mrt-tracker-app/tools'
          cat > 'mrt-tracker-app/tools/build_sounds.py' <<'MRTAPP_EOF'
          """Train sounds for the Drive game, from SMRTOSG's OpenBVE trains (by Danish Rusdi, SG5937C), used with
          their owners' permission. Runs on GitHub when the app is built:
            python3 tools/build_sounds.py <app project folder> [cache folder]

          The trains in the app that have an OpenBVE train: R151 (SMRT Alstom Movia R151), C151A, C151B and C151C (SMRT
          Kawasaki & Sifang C151A/B/C). SMRTOSG lists its newest downloads in releases/releases-data.json on GitHub; the links
          below are used if that list can't be read. Each train (40-100 MB, a .7z) is downloaded on GitHub's side and only its
          sound.cfg, train.dat and sound files are used:
            - the sounds the train's sound.cfg gives for: motor, running, flange, brake air, brake shoe, doors, horn, master
              controller and brake handle, the cab's own running noise, the stop buzzer, points, and two cab alarms;
            - train.dat's motor sound tables (#MOTOR_P1, P2, B1, B2: which motor sound, its pitch and its volume every
              0.2 km/h, under power and when braking), kept as the points where they change.
          Station announcements in the packs aren't used. Each sound becomes a small mono Ogg Vorbis file (ffmpeg), named by
          its content, so a sound shared by several trains is kept once.

          Writes app/src/main/assets/sounds/: sounds.json and the .ogg files. A copy is kept in the cache folder: a train is
          only downloaded again when SMRTOSG releases a new version. After anything new it writes "sounds-fresh" next to the
          cache folder, so the workflow saves the new copy. This step never fails the build: a train without sounds gets the
          game's own sounds instead.

          sounds.json:
            v: 1, at: "YYYY-MM-DD", src: credit
            models: {model: {name, ver, url, files: [...], motor: {index: file}, tables: {p1|p2|b1|b2: [[row, index, pitch,
                     volume], ...]}  (row = km/h x 5; between two points of the same index, pitch and volume change evenly),
                     run, flange, noise, shoe, release, emergency, horn, hornLoop, doorOpen, doorClose, mcUp, mcDown, mcMin,
                     mcMax, bhApply, bhRelease, bhMin, bhMax, correct, lampOn, lampOff, point, alarm, warn: file names}}
          """
          import hashlib, json, os, re, shutil, subprocess, sys, tempfile, time, urllib.request

          ROOT = sys.argv[1] if len(sys.argv) > 1 else "."
          CACHE = sys.argv[2] if len(sys.argv) > 2 else None
          OUT = os.path.join(ROOT, "app/src/main/assets/sounds")
          SUMMARY = os.environ.get("GITHUB_STEP_SUMMARY")
          DEADLINE = time.time() + float(os.environ.get("SOUNDS_MAX_SECONDS", 10 * 60))
          LIST_URL = "https://raw.githubusercontent.com/smrtosg/main/HEAD/releases/releases-data.json"
          CREDIT = "SMRTOSG (smrtosg.github.io): OpenBVE trains by Danish Rusdi (SG5937C), used with permission"
          # model in the app: (SMRTOSG's name for it in its list of releases, its download if the list can't be read)
          TRAINS = {
              "R151": ("r151", "https://github.com/smrtosg/main/releases/download/v2508.1000/SMRT.Alstom.MOVIA.R151.825-826.825F.7z"),
              "C151A": ("c151a", "https://github.com/smrtosg/smrtosg.github.io/releases/download/v6.0.0/SMRT.KSF.C151A.569-570.569F.7z"),
              "C151B": ("c151b", "https://github.com/smrtosg/smrtosg.github.io/releases/download/v6.0.0/SMRT.KSF.C151B.651-652.651F.7z"),
              "C151C": ("c151c", "https://github.com/smrtosg/smrtosg.github.io/releases/download/v6.0.0/SMRT.KSF.C151C.701-702.701F.7z"),
          }
          SOURCE = re.compile(r"^https://github\.com/smrtosg/[\w.-]+/releases/download/[^\s?#]+\.7z$")
          # recorded announcements and voices are never used, even if a sound.cfg points at one
          VOICE = re.compile(r"chy|announce|doors?[ _-]*(are[ _-]*)?clos|^jm[_ -]|voice|station", re.I)
          TOP_ROW = 120 * 5            # motor tables are kept up to 120 km/h
          report = []


          def say(line=""):
              print(line, flush=True)
              report.append(line)


          def finish():
              if SUMMARY:
                  with open(SUMMARY, "a") as f:
                      f.write("## Train sounds for the Drive game\n\n" + "\n".join(report) + "\n")
              sys.exit(0)


          def get(url, dest=None, limit=300_000_000, timeout=120):
              left = DEADLINE - time.time()
              if left < 10:
                  raise RuntimeError("out of time")
              req = urllib.request.Request(url, headers={"User-Agent": "MRTTracker-build/1.0 (GitHub Actions; train sounds)"})
              with urllib.request.urlopen(req, timeout=min(timeout, left)) as r:
                  if dest is None:
                      data = r.read(limit + 1)
                      if len(data) > limit:
                          raise RuntimeError("too big")
                      return data
                  n = 0
                  with open(dest, "wb") as f:
                      while True:
                          b = r.read(1 << 20)
                          if not b:
                              break
                          n += len(b)
                          if n > limit:
                              raise RuntimeError("too big")
                          f.write(b)
                  return n


          def newest():
              """{model: (download, version)} from SMRTOSG's list of releases, or the links above."""
              out = {m: (url, "") for m, (_, url) in TRAINS.items()}
              try:
                  j = json.loads(get(LIST_URL, limit=2_000_000, timeout=30).decode("utf-8"))
                  for m, (key, _) in TRAINS.items():
                      for v in ((j.get(key) or {}).get("versions") or {}).values():
                          u = (v.get("downloadUrl") or "").strip()
                          if v.get("label") == "latest-release" and SOURCE.match(u):
                              out[m] = (u, str(v.get("version", "")))
                              break
              except Exception as e:
                  say(f"SMRTOSG's list of releases couldn't be read ({type(e).__name__}), so the saved links are used.")
              return out


          # ---------- tools: ffmpeg to convert, 7z to unpack (the Python reader next to this file if 7z can't be had) ----------
          def which(*names):
              return next((shutil.which(n) for n in names if shutil.which(n)), None)


          def run(args, timeout=300):
              return subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)


          def get_tools():
              need = [pkg for names, pkg in ((("ffmpeg",), "ffmpeg"), (("7z", "7za", "7zz"), "p7zip-full")) if not which(*names)]
              if need and which("apt-get") and which("sudo"):
                  say(f"Installing {' and '.join(need)}…")
                  env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
                  install = ["sudo", "-n", "-E", "apt-get", "install", "-y", "-q", "--no-install-recommends", *need]
                  for args in (install, ["sudo", "-n", "-E", "apt-get", "update", "-q"], install):
                      try:
                          r = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=240, env=env)
                          if args is install and r.returncode == 0:
                              break
                      except Exception:
                          pass
              ff = which("ffmpeg")
              codec = None
              if ff:
                  enc = run([ff, "-hide_banner", "-encoders"]).stdout.decode("utf-8", "replace")
                  codec = "libvorbis" if " libvorbis " in enc else "libopus" if " libopus " in enc else "pcm"
              return ff, codec, which("7z", "7za", "7zz")


          def unpack(archive, dest, sz):
              if sz:
                  r = run([sz, "x", "-y", "-bd", "-o" + dest, archive], timeout=300)
                  if r.returncode == 0:
                      return
              sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
              import sevenz
              sevenz.extract(archive, dest, (".wav", ".cfg", ".dat", ".txt"))


          # ---------- reading an OpenBVE train ----------
          def ifind(base, rel):
              """The file at rel under base, matching names whatever their case ('sound\\Motor1.wav' finds sounds/motor1.WAV)."""
              cur = base
              for part in [p for p in re.split(r"[\\/]+", rel.strip()) if p and p != "."]:
                  if part == ".." or not os.path.isdir(cur):
                      return None
                  hit = next((n for n in sorted(os.listdir(cur)) if n.lower() == part.lower()), None)
                  if hit is None:
                      return None
                  cur = os.path.join(cur, hit)
              return cur if os.path.isfile(cur) else None


          def read_text(path):
              raw = open(path, "rb").read()
              for enc in ("utf-8-sig", "cp1252", "latin-1"):
                  try:
                      return raw.decode(enc)
                  except UnicodeDecodeError:
                      pass
              return raw.decode("utf-8", "replace")


          def parse_cfg(path):
              """sound.cfg: {section: {key: value}}, sections and keys in lower case."""
              out, sec = {}, None
              for line in read_text(path).splitlines():
                  s = line.split(";")[0].strip()
                  if not s:
                      continue
                  m = re.match(r"^\[(.+)\]$", s)
                  if m:
                      sec = m.group(1).strip().lower()
                      out.setdefault(sec, {})
                  elif sec is not None and "=" in s:
                      k, v = s.split("=", 1)
                      if v.strip():
                          out[sec][re.sub(r"\s+", " ", k.strip().lower())] = v.strip()
              return out


          def parse_tables(path):
              """train.dat's #MOTOR_P1/P2/B1/B2 rows: (sound index, pitch %, volume /128) every 0.2 km/h."""
              tables, sec = {}, None
              for line in read_text(path).splitlines():
                  s = line.split(";")[0].strip()
                  if not s:
                      continue
                  if s.startswith("#"):
                      k = s.lower()
                      sec = {"#motor_p1": "p1", "#motor_p2": "p2", "#motor_b1": "b1", "#motor_b2": "b2"}.get(k)
                      if sec:
                          tables[sec] = []
                      continue
                  if sec and len(tables[sec]) <= TOP_ROW:
                      vals = [x.strip() for x in s.split(",")]
                      def num(i, d):
                          try:
                              return float(vals[i]) if i < len(vals) and vals[i] else d
                          except ValueError:
                              return d
                      idx = num(0, -1)
                      tables[sec].append((int(round(idx)) if idx >= 0 else -1, max(0.0, num(1, 100)), max(0.0, num(2, 128))))
              return tables


          def simplify(rows):
              """The table as the points where it changes: [row, index, pitch, volume], straight lines between points of the same index."""
              out, i = [], 0
              while i < len(rows):
                  j = i
                  while j + 1 < len(rows) and rows[j + 1][0] == rows[i][0]:
                      j += 1
                  keep, stack = {i, j}, [(i, j)]
                  while stack:          # Douglas-Peucker on pitch and volume
                      a, b = stack.pop()
                      worst, at = 0, None
                      for k in range(a + 1, b):
                          t = (k - a) / (b - a)
                          e = max(abs(rows[a][1] + (rows[b][1] - rows[a][1]) * t - rows[k][1]) / 0.25,
                                  abs(rows[a][2] + (rows[b][2] - rows[a][2]) * t - rows[k][2]) / 0.25)
                          if e > worst:
                              worst, at = e, k
                      if worst > 1:
                          keep.add(at)
                          stack += [(a, at), (at, b)]
                  out += [[k, rows[k][0], round(rows[k][1], 2), round(rows[k][2], 2)] for k in sorted(keep)]
                  i = j + 1
              return out


          def max_db(ff, path):
              r = run([ff, "-nostdin", "-hide_banner", "-i", path, "-af", "volumedetect", "-f", "null", "-"], timeout=120)
              m = re.search(r"max_volume:\s*(-?[\d.]+|-inf) dB", r.stderr.decode("utf-8", "replace"))
              return -999.0 if not m or m.group(1) == "-inf" else float(m.group(1))


          def convert(ff, codec, src, files_dir):
              """One sound as a small mono file in files_dir, named by its content; returns the name, or None if it's silent."""
              if max_db(ff, src) < -50:
                  return None
              raw = open(src, "rb").read()
              ext = ".wav" if codec == "pcm" else ".ogg"
              name = hashlib.sha1(raw).hexdigest()[:12] + ext
              dest = os.path.join(files_dir, name)
              if not os.path.exists(dest):
                  enc = {"libvorbis": ["-c:a", "libvorbis", "-q:a", "4"], "libopus": ["-c:a", "libopus", "-b:a", "64k"],
                         "pcm": ["-c:a", "pcm_s16le"]}[codec]
                  tmp = dest + ".part"
                  r = run([ff, "-nostdin", "-v", "error", "-y", "-i", src, "-map", "0:a:0", "-ac", "1", *enc, "-map_metadata", "-1",
                           "-f", "wav" if codec == "pcm" else "ogg", tmp], timeout=180)
                  if r.returncode != 0 or not os.path.exists(tmp) or os.path.getsize(tmp) < 100:
                      raise RuntimeError(f"ffmpeg couldn't convert {os.path.basename(src)}")
                  os.replace(tmp, dest)
              return name


          def build_train(model, url, ver, ff, codec, sz, files_dir):
              work = tempfile.mkdtemp(prefix="obve-")
              try:
                  archive = os.path.join(work, "train.7z")
                  size = get(url, archive)
                  unpack(archive, os.path.join(work, "x"), sz)
                  os.remove(archive)
                  home = None
                  for d, _, fs in os.walk(os.path.join(work, "x")):
                      low = {f.lower() for f in fs}
                      if "train.dat" in low and "sound.cfg" in low:
                          home = d
                          break
                  if not home:
                      raise RuntimeError("no train.dat and sound.cfg in it")
                  cfg = parse_cfg(ifind(home, "sound.cfg"))
                  tables = {k: simplify(v) for k, v in parse_tables(ifind(home, "train.dat")).items() if v}
                  made = {}

                  def sound(rel):
                      if not rel:
                          return None
                      p = ifind(home, rel)
                      if not p or VOICE.search(os.path.basename(p)) or not p.lower().endswith((".wav", ".ogg", ".flac", ".mp3")):
                          return None
                      if p not in made:
                          made[p] = convert(ff, codec, p, files_dir)
                      return made[p]

                  def first(section, *keys):
                      sec = cfg.get(section, {})
                      for k in keys:
                          f = sound(sec.get(k))
                          if f:
                              return f
                      return None

                  def by_name(*stems):        # cab alarm sounds the train's safety system plays, found by file name
                      folders = {os.path.dirname(ifind(home, v) or "") for v in cfg.get("motor", {}).values()} - {""}
                      for folder in sorted(folders):
                          for n in sorted(os.listdir(folder)):
                              if os.path.splitext(n)[0].lower() in stems:
                                  f = sound(os.path.relpath(os.path.join(folder, n), home))
                                  if f:
                                      return f
                      return None

                  motor = {}
                  for k, v in cfg.get("motor", {}).items():
                      if k.isdigit():
                          f = sound(v)
                          if f:
                              motor[k] = f
                  used = {str(r[1]) for t in tables.values() for r in t if r[1] >= 0}
                  if not motor or not used & set(motor):
                      raise RuntimeError("no motor sounds")
                  runs = cfg.get("run", {})
                  # SMRTOSG's lines play run sound 1 on their main tracks (Train.Run(1).Set 1)
                  run_key = "1" if "1" in runs else "0" if "0" in runs else min(runs, key=lambda k: int(k) if k.isdigit() else 99, default=None)
                  horn_sec = cfg.get("horn", {})
                  e = {"name": os.path.basename(home), "ver": ver, "url": url, "motor": motor, "tables": tables,
                       "run": sound(runs.get(run_key)) if run_key else None,
                       "flange": first("flange", "0", *sorted(cfg.get("flange", {}))),
                       "noise": first("others", "noise"), "shoe": first("others", "shoe"),
                       "release": first("brake", "bc release full", "bc release", "bc release high"),
                       "emergency": first("brake", "emergency"),
                       "horn": first("horn", "primaryloop", "primary"), "hornLoop": "primaryloop" in horn_sec and not horn_sec.get("primary"),
                       "doorOpen": first("door", "open left", "open right"), "doorClose": first("door", "close left", "close right"),
                       "mcUp": first("master controller", "up", "upfast"), "mcDown": first("master controller", "down", "downfast"),
                       "mcMin": first("master controller", "min"), "mcMax": first("master controller", "max"),
                       "bhApply": first("brake handle", "apply", "applyfast"), "bhRelease": first("brake handle", "release", "releasefast"),
                       "bhMin": first("brake handle", "min"), "bhMax": first("brake handle", "max"),
                       "correct": first("buzzer", "correct"), "lampOn": first("pilot lamp", "on"), "lampOff": first("pilot lamp", "off"),
                       "point": first("switch", "0") or first("point frontaxle", "0"),
                       "alarm": by_name("emgstop"), "warn": by_name("overspeed") or first("buzzer", "correct")}
                  e = {k: v for k, v in e.items() if v not in (None, "", {}, [])}
                  e["files"] = sorted({f for f in made.values() if f})
                  say(f"✅ {model}: {e['name']}{f' v{ver}' if ver else ''} ({size / 1e6:.0f} MB download), {len(e['files'])} sounds.")
                  return e
              finally:
                  shutil.rmtree(work, ignore_errors=True)


          def main():
              cache = CACHE or tempfile.mkdtemp(prefix="sound-cache-")
              files_dir = os.path.join(cache, "files")
              os.makedirs(files_dir, exist_ok=True)
              idx_path = os.path.join(cache, "index.json")
              try:
                  index = json.load(open(idx_path))
                  assert index.get("v") == 1
              except Exception:
                  index = {"v": 1, "trains": {}, "models": {}}
              have = lambda e: e and all(os.path.exists(os.path.join(files_dir, f)) for f in e.get("files", []))
              fresh, models, tools = False, {}, None
              for model, (url, ver) in newest().items():
                  saved = index["trains"].get(url)
                  if have(saved):
                      models[model] = saved
                      continue
                  try:
                      if tools is None:
                          tools = get_tools()
                          if not tools[0]:
                              say("⚠️ ffmpeg isn't available, so no sounds can be converted this time.")
                      if not tools[0]:
                          raise RuntimeError("no ffmpeg")
                      e = build_train(model, url, ver, tools[0], tools[1], tools[2], files_dir)
                      index["trains"][url] = e
                      index["models"][model] = url
                      models[model] = e
                      fresh = True
                  except Exception as ex:
                      old = index["trains"].get(index["models"].get(model, ""))
                      if have(old):
                          models[model] = old
                          say(f"⚠️ {model}: the newest train couldn't be used ({type(ex).__name__}: {ex}); keeping the one saved before.")
                      else:
                          say(f"⚠️ {model}: no sounds ({type(ex).__name__}: {ex}); the game makes its own for this train.")
              if fresh:
                  json.dump(index, open(idx_path, "w"), separators=(",", ":"))
                  if CACHE:
                      open(os.path.join(os.path.dirname(os.path.abspath(CACHE)), "sounds-fresh"), "w").write("sounds\n")
              if not models:
                  say("No train sounds this time: the Drive game makes its own.")
                  return
              os.makedirs(OUT, exist_ok=True)
              total = 0
              for f in sorted({f for e in models.values() for f in e["files"]}):
                  shutil.copyfile(os.path.join(files_dir, f), os.path.join(OUT, f))
                  total += os.path.getsize(os.path.join(OUT, f))
              json.dump({"v": 1, "at": time.strftime("%Y-%m-%d"), "src": CREDIT, "models": models},
                        open(os.path.join(OUT, "sounds.json"), "w"), separators=(",", ":"))
              say(f"Packed sounds for {', '.join(sorted(models))}: {total / 1e6:.1f} MB.")


          try:
              main()
          except Exception as e:
              say(f"⚠️ The train sounds step hit an error ({type(e).__name__}: {e}). The Drive game makes its own sounds.")
          finish()
          MRTAPP_EOF
          mkdir -p 'mrt-tracker-app/tools'
          cat > 'mrt-tracker-app/tools/build_timetable.py' <<'MRTAPP_EOF'
          """Download LTA's official train timetable (GTFS Schedule (Train), LTA DataMall) and pack it for the app.

          Runs on GitHub during every build:  python3 tools/build_timetable.py <app project folder> [saved copy]

          Writes app/src/main/assets/timetable.json, which the app uses for exact train times. If anything
          goes wrong (no connection, unexpected format) it writes no timetable and the app falls back to
          estimates, so the build never fails because of this step. A report of what matched is written to
          the GitHub job summary.

          With a saved copy (the workflow keeps one in the repository, data/lta-timetable.json), every good
          download is also saved there, and when LTA's download fails the last good timetable is packed instead,
          so every version of the app has LTA's timetable.

          timetable.json:
            feed:     {source, built, files}
            services: [[service_id, "1111100" (Mon..Sun), start "YYYYMMDD", end "YYYYMMDD"], ...]
            except:   {"YYYYMMDD": [[service index, 1 = added | 2 = removed], ...]}
            lines:    {NSL: {pats: [[first station index, step +1/-1, [arrive s], [depart s], destination index], ...],
                             trips: [[start s since midnight, pattern index, service index], ...]}, ...}
                      The destination is the station the trip is headed for (its headsign), so special-bound trains
                      that end partway along the line show where they end; -1 when it's simply where the run ends,
                      -2 for a full loop back to where it started.
          """
          import csv, hashlib, io, json, os, re, shutil, sys, time, urllib.request, zipfile

          ROOT = sys.argv[1] if len(sys.argv) > 1 else "."
          OUT = os.path.join(ROOT, "app/src/main/assets/timetable.json")
          SAVED = sys.argv[2] if len(sys.argv) > 2 else None
          LINES = json.load(open(os.path.join(ROOT, "tools/lines.json")))
          SUMMARY = os.environ.get("GITHUB_STEP_SUMMARY")
          API = "https://datamall2.mytransport.sg/ltaodataservice/GTFSScheduleTrain"
          report = []

          def say(line=""):
              print(line)
              report.append(line)

          def use_saved():
              """LTA's download didn't work: pack the last good timetable instead, if there is one."""
              if not SAVED or not os.path.exists(SAVED):
                  say("\nThere's no saved timetable to fall back on yet, so this version of the app uses estimates.")
                  return False
              try:
                  j = json.load(open(SAVED))
                  os.makedirs(os.path.dirname(OUT), exist_ok=True)
                  shutil.copyfile(SAVED, OUT)
                  ends = max((s[3] for s in j.get("services", [])), default="")
                  say(f"\n✅ Packed the last good timetable instead: downloaded {j['feed']['built']}, {len(j['lines'])} lines"
                      + (f", covering dates up to {ends[:4]}-{ends[4:6]}-{ends[6:]}" if ends and ends < "2999" else "") + ".")
                  if ends and ends < time.strftime("%Y%m%d"):
                      say("⚠️ That timetable's dates have passed, so the app uses estimates until LTA's download works again.")
                  return True
              except Exception as e:
                  say(f"\n⚠️ The saved timetable couldn't be read ({e}), so this version of the app uses estimates.")
                  return False

          def keep_copy(res):
              """Save a good download to the repository copy, unless it's the same timetable as last time."""
              if not SAVED:
                  return
              try:
                  strip = lambda j: json.dumps({k: v for k, v in j.items() if k != "feed"}, sort_keys=True)
                  old = json.load(open(SAVED)) if os.path.exists(SAVED) else None
                  if old and strip(old) == strip(json.loads(json.dumps(res))):
                      say("Same timetable as the saved copy.")
                      return
                  os.makedirs(os.path.dirname(SAVED) or ".", exist_ok=True)
                  shutil.copyfile(OUT, SAVED)
                  say("Saved a copy to the repository (data/lta-timetable.json), for any build where LTA's download fails.")
              except Exception as e:
                  say(f"⚠️ Couldn't keep a copy of the timetable ({e}).")

          def finish(ok):
              if not ok:
                  if os.path.exists(OUT):
                      os.remove(OUT)
                  use_saved()
              if SUMMARY:
                  with open(SUMMARY, "a") as f:
                      f.write("## LTA train timetable\n\n" + "\n".join(report) + "\n")
              sys.exit(0)

          # ---------- the LTA key (stored scrambled in app/build.gradle) ----------
          def lta_key():
              g = open(os.path.join(ROOT, "app/build.gradle")).read()
              m = re.search(r"LTA_KEY_X',\s*'\"([0-9a-f]+)\"'", g)
              if not m:
                  return ""
              mask = hashlib.sha256(b"sg.mrttracker.app").digest()
              hx = m.group(1)
              key = bytes(int(hx[i:i + 2], 16) ^ mask[(i // 2) % 32] for i in range(0, len(hx), 2)).decode()
              print("::add-mask::" + key)
              return key

          def http(url, headers=None, tries=3):
              for t in range(tries):
                  try:
                      req = urllib.request.Request(url, headers=headers or {})
                      with urllib.request.urlopen(req, timeout=60) as r:
                          return r.read()
                  except Exception as e:
                      if t == tries - 1:
                          raise
                      time.sleep(3 * (t + 1))

          def find_link(o):
              if isinstance(o, str):
                  return o if o.startswith("https://") and "gtfs" in o.lower() else None
              if isinstance(o, dict):
                  for k in ("Link", "link"):
                      if isinstance(o.get(k), str) and o[k].startswith("https://"):
                          return o[k]
                  o = list(o.values())
              if isinstance(o, list):
                  for v in o:
                      r = find_link(v)
                      if r:
                          return r
              return None

          # ---------- station matching ----------
          def norm(s):
              s = s.lower().replace("&", "and")
              s = re.sub(r"\([^)]*\)", " ", s)
              s = re.sub(r"\b(mrt|lrt)\b|\bstation\b|\binterchange\b|\bplatform\b.*$", " ", s)
              return re.sub(r"[^a-z0-9]", "", s)

          NAME_IDX, CODE_IDX = {}, {}         # normalised name / code -> [(line, index)]
          for line, L in LINES.items():
              for i, (code, name) in enumerate(L["stations"]):
                  NAME_IDX.setdefault(norm(name), []).append((line, i))
                  CODE_IDX.setdefault(code.upper(), []).append((line, i))
          CODE_ALIASES = {"CE1": "CC34", "CE2": "CC33"}
          CODE_RE = re.compile(r"\b(NS|EW|CG|NE|CC|CE|DT|TE|BP|SE|SW|PE|PW)\s?(\d{1,2})\b|\b(STC|PTC)\b", re.I)

          def stop_candidates(stop, stops):
              """All (line, index) this GTFS stop could be, from station codes first, then names."""
              texts = [stop.get("stop_code", ""), stop.get("stop_id", ""), stop.get("stop_name", "")]
              parent = stops.get(stop.get("parent_station") or "")
              if parent:
                  texts += [parent.get("stop_code", ""), parent.get("stop_id", ""), parent.get("stop_name", "")]
              found = []
              for t in texts:
                  for m in CODE_RE.finditer(t or ""):
                      code = (m.group(1) + m.group(2)).upper() if m.group(1) else m.group(3).upper()
                      code = CODE_ALIASES.get(code, code)
                      found += CODE_IDX.get(code, [])
              names = [parent.get("stop_name", "")] if parent else []
              names.append(stop.get("stop_name", ""))
              for n in names:
                  found += NAME_IDX.get(norm(n or ""), [])
              return sorted(set(found))

          MAX_STEP = 2      # stops next to each other on a trip are at most this far apart in the app's station list

          def legs_for(seq, line):
              """Split one trip's stops into runs that move one way along `line`. seq: [(cands_on_line, arr, dep)].
              A run also breaks where two stops in a row aren't neighbours in the app's list, such as where the
              Circle Line's loop joins (Promenade and Bayfront), so no run is drawn across the whole line."""
              legs, cur = [], None
              for cands, arr, dep in seq:
                  if cur is None:
                      cur = {"rows": [(cands, arr, dep)], "idx": [], "dir": 0}
                      continue
                  if not cur["idx"]:
                      prev = cur["rows"][-1][0]
                      pairs = [(abs(a - b), a, b) for a in prev for b in cands if a != b]
                      if not pairs or min(pairs)[0] > MAX_STEP:
                          cur = {"rows": [(cands, arr, dep)], "idx": [], "dir": 0}
                          continue
                      _, a, b = min(pairs)
                      cur["rows"] = [cur["rows"][-1], (cands, arr, dep)]
                      cur["idx"] = [a, b]
                      cur["dir"] = 1 if b > a else -1
                      continue
                  last, d = cur["idx"][-1], cur["dir"]
                  ahead = [x for x in cands if (x - last) * d > 0]
                  nxt = min(ahead, key=lambda x: abs(x - last)) if ahead else None
                  if nxt is not None and abs(nxt - last) <= MAX_STEP:
                      cur["rows"].append((cands, arr, dep))
                      cur["idx"].append(nxt)
                  else:                                   # the train turns (or jumps): start a new run from the last stop
                      legs.append(cur)
                      prow = cur["rows"][-1]
                      cur = {"rows": [prow], "idx": [], "dir": 0}
                      # a station can appear twice on a line (Bukit Panjang on the BP loop): pick the closest pair
                      pairs = [(abs(a - b), a, b) for a in prow[0] for b in cands if b != a]
                      if pairs and min(pairs)[0] <= MAX_STEP:
                          _, a, b = min(pairs)
                          cur["rows"].append((cands, arr, dep))
                          cur["idx"] = [a, b]
                          cur["dir"] = 1 if b > a else -1
                      else:
                          cur = {"rows": [(cands, arr, dep)], "idx": [], "dir": 0}
              if cur and cur["idx"]:
                  legs.append(cur)
              return legs

          def headsign_idx(trip, line, legs):
              """Where a trip is headed, as a station index on its line: the trip's headsign if it names a station
              on the line, else (for a trip that turns or wraps, so its runs end before it does) its last stop.
              -1: where each run ends. -2: a trip that goes round and back to where it started (a full loop)."""
              h = headsign_station(trip, line, legs)
              first = legs[0]["idx"][0]
              if len(legs) > 1 and h >= 0 and (h == first or LINES[line]["stations"][h][0] == LINES[line]["stations"][first][0]):
                  return -2
              return h

          def headsign_station(trip, line, legs):
              hs = (trip.get("trip_headsign") or "").strip()
              if hs:
                  hs = re.sub(r"^\s*(to|towards|for)\s+", "", hs, flags=re.I)
                  found = []
                  for m in CODE_RE.finditer(hs):
                      code = (m.group(1) + m.group(2)).upper() if m.group(1) else m.group(3).upper()
                      found += [i for l, i in CODE_IDX.get(CODE_ALIASES.get(code, code), []) if l == line]
                  if not found:
                      found = [i for l, i in NAME_IDX.get(norm(CODE_RE.sub(" ", hs)), []) if l == line]
                  if found:
                      last = legs[-1]["idx"][-1]
                      return min(found, key=lambda i: abs(i - last))       # a hub listed twice: the one nearest the trip's end
              return legs[-1]["idx"][-1] if len(legs) > 1 else -1

          def secs(t):
              h, m, s = (t or "").strip().split(":")
              return int(h) * 3600 + int(m) * 60 + int(s)

          def main():
              local = os.environ.get("MRT_GTFS_ZIP")      # for testing with a file instead of downloading
              if local:
                  data = open(local, "rb").read()
                  z = zipfile.ZipFile(io.BytesIO(data))
                  return process(z, data)
              key = lta_key()
              if not key:
                  say("⚠️ No LTA key found in the app, so the timetable was skipped.")
                  finish(False)
              try:
                  meta = http(API, {"AccountKey": key, "accept": "application/json"})
                  link = find_link(json.loads(meta))
                  if not link:
                      raise ValueError("LTA's reply had no download link: " + meta[:200].decode("utf-8", "replace"))
                  data = http(link)
                  z = zipfile.ZipFile(io.BytesIO(data))
              except Exception as e:
                  say(f"⚠️ Couldn't download the timetable from LTA ({e}).")
                  finish(False)

              return process(z, data)

          def process(z, data):
              def table(name):
                  n = next((x for x in z.namelist() if x.split("/")[-1].lower() == name), None)
                  if not n:
                      return []
                  txt = z.read(n).decode("utf-8-sig", "replace")
                  return list(csv.DictReader(io.StringIO(txt)))

              say(f"Downloaded **{len(data) // 1024} KB** from LTA DataMall.")
              files = sorted(x.split("/")[-1] for x in z.namelist())
              say("Files: " + ", ".join(f"`{f}`" for f in files))
              say("")
              say("<details><summary>First lines of each file</summary>\n")
              for n in z.namelist():
                  if n.endswith(".txt"):
                      head = z.read(n).decode("utf-8-sig", "replace").splitlines()[:3]
                      say(f"**{n}**\n```\n" + "\n".join(h[:300] for h in head) + "\n```")
              say("</details>\n")

              stops = {s["stop_id"]: s for s in table("stops.txt")}
              trips = {t["trip_id"]: t for t in table("trips.txt")}
              freqs = {}
              for f in table("frequencies.txt"):
                  freqs.setdefault(f["trip_id"], []).append(f)
              st_by_trip = {}
              for r in table("stop_times.txt"):
                  st_by_trip.setdefault(r["trip_id"], []).append(r)
              cal = table("calendar.txt")
              cdates = table("calendar_dates.txt")

              services, svc_index = [], {}
              def svc(sid):
                  if sid not in svc_index:
                      svc_index[sid] = len(services)
                      services.append([sid, "0000000", "19000101", "29991231"])
                  return svc_index[sid]
              for c in cal:
                  i = svc(c["service_id"])
                  days = "".join("1" if c.get(d, "0").strip() == "1" else "0"
                                 for d in ("monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"))
                  services[i][1:] = [days, c.get("start_date", "19000101").strip(), c.get("end_date", "29991231").strip()]
              exc = {}
              for c in cdates:
                  exc.setdefault(c["date"].strip(), []).append([svc(c["service_id"]), int(c.get("exception_type", "1") or 1)])

              stop_cands = {sid: stop_candidates(s, stops) for sid, s in stops.items()}
              unmatched_stops = sorted({stops[sid].get("stop_name", sid) for sid, c in stop_cands.items()
                                        if not c and stops[sid].get("location_type", "0") in ("", "0")})

              out = {ln: {"pats": [], "trips": []} for ln in LINES}
              pat_idx = {ln: {} for ln in LINES}
              per_line = {ln: 0 for ln in LINES}
              skipped = []

              for tid, rows in st_by_trip.items():
                  if tid not in trips:
                      continue
                  rows.sort(key=lambda r: int(r["stop_sequence"]))
                  cands = [stop_cands.get(r["stop_id"], []) for r in rows]
                  # which line covers most of this trip's stops?
                  score = {}
                  for cs in cands:
                      for ln in {c[0] for c in cs}:
                          score[ln] = score.get(ln, 0) + 1
                  if not score:
                      skipped.append((tid, "no stops matched"))
                      continue
                  line = max(score, key=lambda l: (score[l], -len(LINES[l]["stations"])))
                  if score[line] < 2 or score[line] < 0.9 * len(rows):
                      skipped.append((tid, f"only {score[line]}/{len(rows)} stops on {line}"))
                      continue
                  seq = []
                  for r, cs in zip(rows, cands):
                      on = sorted(i for l, i in cs if l == line)
                      if not on:
                          continue
                      try:
                          arr = secs(r.get("arrival_time") or r.get("departure_time"))
                          dep = secs(r.get("departure_time") or r.get("arrival_time"))
                      except Exception:
                          continue
                      seq.append((on, arr, dep))
                  sid = svc(trips[tid]["service_id"])
                  trip_t0 = seq[0][2] if seq else 0
                  starts_extra = []
                  for f in freqs.get(tid, []):
                      a, b, h = secs(f["start_time"]), secs(f["end_time"]), int(f["headway_secs"])
                      starts_extra += list(range(a, b, max(30, h)))
                  legs = legs_for(seq, line)
                  head = headsign_idx(trips[tid], line, legs) if legs else -1
                  for leg in legs:
                      idx, d = leg["idx"], leg["dir"]
                      t0 = leg["rows"][0][2]
                      times = {}
                      for (cs, arr, dep), i in zip(leg["rows"], idx):
                          times[i] = (arr - t0, dep - t0)
                      times[idx[0]] = (0, 0)
                      span = list(range(idx[0], idx[-1] + d, d))
                      known = [i for i in span if i in times]
                      arrs, deps = [], []
                      for i in span:
                          if i in times:
                              a, b = times[i]
                          else:                           # not listed (shouldn't happen): interpolate
                              lo = max(k for k in known if (k - i) * d < 0)
                              hi = min(k for k in known if (k - i) * d > 0)
                              frac = abs(i - lo) / abs(hi - lo)
                              a = b = round(times[lo][1] + frac * (times[hi][0] - times[lo][1]))
                          arrs.append(a)
                          deps.append(max(a, b))
                      key = (idx[0], d, tuple(arrs), tuple(deps), head)
                      if key not in pat_idx[line]:
                          pat_idx[line][key] = len(out[line]["pats"])
                          out[line]["pats"].append([idx[0], d, arrs, deps, head])
                      p = pat_idx[line][key]
                      if starts_extra:
                          for s0 in starts_extra:         # frequency-based trips: one run per interval
                              out[line]["trips"].append([s0 + (t0 - trip_t0), p, sid])
                      else:
                          out[line]["trips"].append([t0, p, sid])
                      per_line[line] += 1

              for ln in out:
                  out[ln]["trips"].sort()
              lines_ok = [ln for ln in out if out[ln]["trips"]]

              def special(ln):
                  """Runs headed somewhere other than the end of the line (special-bound trains). Not counted on
                  loops, where most runs are headed back round to where they started."""
                  if ln in ("CCL", "BP", "SE", "SW", "PE", "PW"):
                      return "–"
                  last = len(LINES[ln]["stations"]) - 1
                  ends = [p[4] if p[4] >= 0 else -1 if p[4] == -2 else p[0] + p[1] * (len(p[2]) - 1) for p in out[ln]["pats"]]
                  ends = [e if e >= 0 else (last if p[1] > 0 else 0) for e, p in zip(ends, out[ln]["pats"])]
                  return sum(1 for t in out[ln]["trips"] if ends[t[1]] != (last if out[ln]["pats"][t[1]][1] > 0 else 0))
              say("| Line | Train runs | Stop patterns | Special-bound runs |")
              say("|---|---|---|---|")
              for ln in LINES:
                  say(f"| {ln} | {len(out[ln]['trips'])} | {len(out[ln]['pats'])} | {special(ln)} |")
              say("")
              say(f"Service calendars: {len(services)} · dates with exceptions: {len(exc)}")
              if unmatched_stops:
                  say(f"\n⚠️ Stops not matched to a station ({len(unmatched_stops)}): " + ", ".join(unmatched_stops[:40]))
              if skipped:
                  say(f"\n⚠️ Trips skipped: {len(skipped)} of {len(st_by_trip)}. Examples: " +
                      "; ".join(f"`{t}` ({why})" for t, why in skipped[:8]))
              if not lines_ok:
                  say("\n⚠️ No lines could be matched to the app's stations.")
                  finish(False)

              feed = {"source": "LTA DataMall, GTFS Schedule (Train)", "built": time.strftime("%Y-%m-%d", time.gmtime()),
                      "lines": lines_ok}
              res = {"feed": feed, "services": services, "except": exc,
                     "lines": {ln: out[ln] for ln in lines_ok}}
              os.makedirs(os.path.dirname(OUT), exist_ok=True)
              with open(OUT, "w") as f:
                  json.dump(res, f, separators=(",", ":"))
              say(f"\n✅ Timetable packed for {len(lines_ok)} lines ({os.path.getsize(OUT) // 1024} KB). "
                  f"Lines without data use estimates: {', '.join(l for l in LINES if l not in lines_ok) or 'none'}.")
              keep_copy(res)
              finish(True)

          if __name__ == "__main__":
              try:
                  main()
              except SystemExit:
                  raise
              except Exception as e:
                  say(f"⚠️ The timetable step hit an error ({type(e).__name__}: {e}).")
                  finish(False)
          MRTAPP_EOF
          mkdir -p 'mrt-tracker-app/tools'
          cat > 'mrt-tracker-app/tools/build_tracks.py' <<'MRTAPP_EOF'
          """Real track shapes for the RTS Link and the Sentosa Express, which SG Rail Data doesn't have.

          Runs on GitHub during every build:  python3 tools/build_tracks.py <app project folder> [cache folder]

          The tracks come from OpenStreetMap (data (c) OpenStreetMap contributors, ODbL), through the Overpass API:
          the route relations for each line, as listed on the OpenStreetMap wiki page "Singapore/Rail Transport":
            Sentosa Express  2353581 (VivoCity > Beach), 9663249 (Beach > VivoCity)
            RTS Link         19927885 (Bukit Chagar > Woodlands North), 19927886 (Woodlands North > Bukit Chagar)
          If those ever change, it also looks the routes up by name. Each route's track is cut at the app's stations,
          so the line runs station to station along the real track, in the app's own map projection.

          A copy is kept in the cache folder. If the download fails, the last saved copy is used; with neither,
          the app keeps its straight lines for these two lines. After a download that changed the tracks it writes
          "osm-fresh" next to the cache folder, so the workflow saves the new copy. This step never fails the build.

          tracks.json:
            v: 2, src: attribution, at: "YYYY-MM-DD", rel: {line: OpenStreetMap relation id}
            paths: {line: [[x, y, x, y, ...], ...]}  one path per pair of neighbouring stations, in the app's station
                   order, in the map's own metres (x east, y south of central Singapore), like the map's other lines
          """
          import json, math, os, re, sys, time, urllib.parse, urllib.request

          ROOT = sys.argv[1] if len(sys.argv) > 1 else "."
          CACHE = sys.argv[2] if len(sys.argv) > 2 else None
          ASSETS = os.path.join(ROOT, "app/src/main/assets")
          OUT = os.path.join(ASSETS, "tracks.json")
          SUMMARY = os.environ.get("GITHUB_STEP_SUMMARY")
          ENDPOINTS = [u for u in os.environ.get("OVERPASS_URLS", "").split() if u] or [
              "https://overpass-api.de/api/interpreter",
              "https://overpass.kumi.systems/api/interpreter",
              "https://maps.mail.ru/osm/tools/overpass/api/interpreter",
              "https://overpass.private.coffee/api/interpreter"]
          DEADLINE = time.time() + float(os.environ.get("TRACKS_MAX_SECONDS", 3 * 60))
          # Same projection as the map (build_map.py): metres east and south of central Singapore.
          LAT0, LON0 = 1.3521, 103.8198
          KX, KY = 111320 * math.cos(math.radians(LAT0)), 110574
          # line: (route in the app's station order, the same route the other way, how to find it by name if the ids change)
          ROUTES = {
              "SEN": (2353581, 9663249, '["type"="route"]["route"="monorail"]["name"~"Sentosa Express"](1.22,103.80,1.27,103.85)'),
              "RTS": (19927885, 19927886, '["type"="route"]["ref"="RTS"](1.40,103.70,1.50,103.82)'),
          }
          TRACK_ROLES = {"", "forward", "backward", "main"}
          NAMES = {"SEN": "Sentosa Express", "RTS": "RTS Link"}
          NEAR = 600            # a station must be within this many metres of the track
          report = []


          def say(line=""):
              print(line)
              report.append(line)


          def finish():
              if SUMMARY:
                  with open(SUMMARY, "a") as f:
                      f.write("## RTS Link and Sentosa Express tracks\n\n" + "\n".join(report) + "\n")
              sys.exit(0)


          def to_xy(lat, lon):
              return (lon - LON0) * KX, -(lat - LAT0) * KY


          def dist(a, b):
              return math.hypot(a[0] - b[0], a[1] - b[1])


          def app_lines():
              """The app's stations for each line here (in order) and where they are on its map."""
              html = open(os.path.join(ASSETS, "index.html"), encoding="utf-8").read()
              m = re.search(r'const MAP = \{"stations":(\{[^{}]*\})', html)
              pos = json.loads(m.group(1))
              out = {}
              for code in ROUTES:
                  lm = re.search(r'\n  ' + code + r':\{name:"[^"]+"[^\n]*?stations:\[(.*?)\]\}', html)
                  seq = re.findall(r'\["([A-Z]+\d*[A-Z]?)","', lm.group(1)) if lm else []
                  if len(seq) >= 2 and all(c in pos for c in seq):
                      out[code] = [(c, tuple(pos[c])) for c in seq]
              return out


          def overpass():
              ids = ",".join(str(i) for a, b, _ in ROUTES.values() for i in (a, b))
              by_name = "".join(f"relation{q};" for _, _, q in ROUTES.values())
              query = f"[out:json][timeout:90];(relation(id:{ids});{by_name});out geom;"
              data = urllib.parse.urlencode({"data": query}).encode()
              last = None
              for attempt in range(2):
                  for url in ENDPOINTS:
                      left = DEADLINE - time.time()
                      if left < 5:
                          raise RuntimeError(f"out of time ({last})")
                      try:
                          req = urllib.request.Request(url, data=data, headers={"User-Agent": "MRTTracker-build/1.0 (GitHub Actions; RTS Link and Sentosa Express tracks)"})
                          with urllib.request.urlopen(req, timeout=min(120, left)) as r:
                              j = json.loads(r.read().decode("utf-8"))
                          if "elements" in j and not j.get("remark", "").lower().startswith("runtime error"):
                              return j["elements"]
                          last = j.get("remark", "no elements")
                      except Exception as e:
                          last = f"{type(e).__name__}: {e}"
                      time.sleep(2 + attempt * 6)
              raise RuntimeError(last)


          def track_of(rel):
              """The route's track as one line of map points, joining its ways end to end in the route's order."""
              ways = [[to_xy(p["lat"], p["lon"]) for p in m["geometry"] if p]
                      for m in rel.get("members", [])
                      if m.get("type") == "way" and m.get("role", "") in TRACK_ROLES and len(m.get("geometry") or []) >= 2]
              line = []
              for i, w in enumerate(ways):
                  if not line:
                      line = list(w)
                      continue
                  options = [(dist(line[-1], w[0]), line, w), (dist(line[-1], w[-1]), line, w[::-1])]
                  if i == 1:      # the first way's direction is only known once the second one is joined on
                      options += [(dist(line[0], w[0]), line[::-1], w), (dist(line[0], w[-1]), line[::-1], w[::-1])]
                  gap, base, nxt = min(options, key=lambda o: o[0])
                  line = base + (nxt[1:] if gap < 1 else nxt)
              return line


          def along(line):
              cum = [0.0]
              for i in range(1, len(line)):
                  cum.append(cum[-1] + dist(line[i - 1], line[i]))
              return cum


          def place(line, cum, p):
              """How far along the track the point nearest to p is, and how far p is from the track."""
              best = (1e18, 0.0)
              for i in range(len(line) - 1):
                  a, b = line[i], line[i + 1]
                  dx, dy = b[0] - a[0], b[1] - a[1]
                  L2 = dx * dx + dy * dy
                  t = 0 if L2 == 0 else max(0, min(1, ((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / L2))
                  d = dist(p, (a[0] + t * dx, a[1] + t * dy))
                  if d < best[0]:
                      best = (d, cum[i] + t * math.sqrt(L2))
              return best[1], best[0]


          def simplify(pts, tol):
              if len(pts) < 3:
                  return pts
              a, b = pts[0], pts[-1]
              dx, dy = b[0] - a[0], b[1] - a[1]
              L = math.hypot(dx, dy) or 1e-9
              dmax, idx = 0, 0
              for i in range(1, len(pts) - 1):
                  d = abs(dy * pts[i][0] - dx * pts[i][1] + b[0] * a[1] - b[1] * a[0]) / L
                  if d > dmax:
                      dmax, idx = d, i
              if dmax <= tol:
                  return [a, b]
              return simplify(pts[: idx + 1], tol)[:-1] + simplify(pts[idx:], tol)


          def cut(line, stations):
              """One path per pair of neighbouring stations, along the track; None if the track doesn't fit."""
              cum = along(line)
              at = []
              for code, p in stations:
                  s, d = place(line, cum, p)
                  if d > NEAR:
                      return None, f"{code} is {d:.0f} m from the track"
                  at.append(s)
              if any(b <= a for a, b in zip(at, at[1:])):
                  return None, "the stations aren't in order along the track"
              paths = []
              for (ca, A), (cb, B), sa, sb in zip(stations, stations[1:], at, at[1:]):
                  pts = [A] + [line[i] for i in range(len(line)) if sa < cum[i] < sb] + [B]
                  length = sum(dist(pts[i - 1], pts[i]) for i in range(1, len(pts)))
                  if length > 2.5 * dist(A, B) + 400:
                      return None, f"the track from {ca} to {cb} is {length:.0f} m, far longer than the stations are apart"
                  pts = simplify(pts, 4)
                  paths.append([v for q in pts for v in (round(q[0]), round(q[1]))])
              return paths, f"{len(line)} track points, {sum(len(p) // 2 for p in paths)} kept"


          def build(elements, lines):
              rels = {e["id"]: e for e in elements if e.get("type") == "relation"}
              paths, used = {}, {}
              for code, (fwd, back, _) in ROUTES.items():
                  if code not in lines:
                      say(f"⚠️ {code}: the app's page has no stations for this line, so it's skipped.")
                      continue
                  names = NAMES[code]
                  # the route in station order first, then the other way, then anything found by name
