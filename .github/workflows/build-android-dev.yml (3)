      - name: Create a signing key on the first run
        run: |
          mkdir -p signing
          if [ ! -f signing/mrt-tracker.jks ]; then
            keytool -genkeypair -v -keystore signing/mrt-tracker.jks -alias mrttracker \
              -keyalg RSA -keysize 2048 -validity 10000 \
              -storepass mrttracker -keypass mrttracker -dname "CN=MRT Tracker"
            git config user.name "github-actions"
            git config user.email "github-actions@users.noreply.github.com"
            git add signing/mrt-tracker.jks
            git commit -m "Add app signing key [skip ci]"
            git push
          fi

      # Downloads LTA's official train timetable and packs it into the app.
      # Never fails the build: without it, the app falls back to estimated times.
      - name: Fetch LTA train timetable
        run: python3 mrt-tracker-app/tools/build_timetable.py mrt-tracker-app data/lta-timetable.json

      # The last good timetable is kept in this repository (data/lta-timetable.json), so a build
      # where LTA's download fails still packs LTA's timetable instead of falling back to estimates.
      - name: Keep the timetable for next time
        run: |
          if [ -f data/lta-timetable.json ] && [ -n "$(git status --porcelain data/lta-timetable.json)" ]; then
            git config user.name "github-actions"
            git config user.email "github-actions@users.noreply.github.com"
            git add data/lta-timetable.json
            git commit -m "Save LTA train timetable [skip ci]"
            git pull --rebase --autostash || true
            git push || echo "::warning::The timetable couldn't be saved to the repository this time. This version of the app still has it."
          fi

