          key: osm-buildings-v1-${{ github.run_id }}
          restore-keys: osm-buildings-v1-

      - name: Fetch buildings from OpenStreetMap
        run: python3 mrt-tracker-app/tools/build_buildings.py mrt-tracker-app osm-cache

      - name: Fetch RTS Link and Sentosa Express tracks from OpenStreetMap
