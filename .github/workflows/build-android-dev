          function showView(v, scrollTo){
            curView = v;
            const up = v === "updates", hi = v === "history", ak = v === "ask", cm = v === "cam", tr = !up && !hi && !ak && !cm;
            $("viewTrains").hidden = !tr; $("viewUpdates").hidden = !up; $("viewHist").hidden = !hi; $("viewAsk").hidden = !ak; $("viewCam").hidden = !cm;
            document.querySelector("footer").hidden = ak || cm;
            $("vAsk").setAttribute("aria-selected", ak); $("vCam").setAttribute("aria-selected", cm);
            if (window.camShown) camShown(cm);               // the live cam only streams while its tab is open
