            const lines = live.map(r => `- ${aLineChip(r.line)} to ${r.toward}: ${r.mins.length ? aGroupEnds(r, now) : r.tomorrow != null ? `no more trains tonight; first one tomorrow at ${clockText(r.tomorrow)}` : "no more trains today"}`);
            const s = soon.map(r => `${r.code} opens ${r.opens}.`);
            if (!live.length) return `**${e.name}** · ${codes}\n${s.join(" ") || "No trains stop here yet."}`;
            return `**${e.name}** · ${codes} · next trains\n${lines.join("\n")}${s.length ? "\n" + s.join(" ") : ""}\n${aTimesNote(live)}`;
          }
          function aFirstLastText(e, now, lineFilter){
            let rows = aStationTrains(e, now).filter(r => !r.opens);
            if (lineFilter){ const cs = aCodesOf(lineFilter); const f = rows.filter(r => cs.includes(r.line)); if (f.length) rows = f; }
            if (!rows.length) return `No trains stop at ${e.name} yet.`;
            return `**${e.name}** · first and last trains today\n${rows.map(r => `- ${aLineChip(r.line)} to ${r.toward}: ${r.first != null ? `first ${clockText(r.first)}, last ${clockText(r.last)}` : "no trains today"}`).join("\n")}\n${aTimesNote(rows)}`;
          }
          function aCrowdText(e){
            const c = aCrowd(e);
            if (!c) return crowdFresh() ? `LTA hasn't sent a crowd level for ${e.name} in its latest update.` : aCrowdNote();
            return `**${e.name}** · platform crowds (LTA, ${c.window})\n${c.levels.map(l => `- ${l.code} (${aLineChip(l.line)}): ${l.level}`).join("\n")}`;
          }
          function aStationHistText(e){
            const op = aOpened(e).map(o => o.opens ? `${o.code} opens ${o.opens}.` : `${o.code} opened on ${o.opened} ${o.how}.`).join(" ");
            const story = H_STN[e.name] || "";
            return `**${e.name}**\n${[op, story].filter(Boolean).join("\n") || "The app has no history for this station yet."}`;
          }
          function aLineText(k, now, focus){
            const F = aLineFacts(k, now), H = F.H, out = [`**${F.name}**${F.op ? ` · run by ${F.op}` : ""}`];
            for (const p of F.parts){
              const label = F.parts.length > 1 ? `${p.name}: ` : "";
              if (!p.open){ out.push(`${label}Not open yet. Passenger service is expected to start ${p.opens.replace(" (expected)", "")}.`); continue; }
              const span = p.loop ? `a loop from ${p.from}, ${p.stations} stations` : `${p.stations} stations, ${p.from} to ${p.to}`;
              const now_ = p.inService ? `Right now ${p.running} train${p.running === 1 ? " is" : "s are"} running${p.every != null ? `, one every ${p.every} min` : ""} (${p.src}).` : `No trains are running right now (${p.src}).`;
              const fl = p.firstA != null ? ` First trains ${clockText(Math.min(p.firstA, p.firstB ?? Infinity))}, last ${clockText(Math.max(p.lastA, p.lastB ?? -Infinity))} from the ends.` : "";
              out.push(`${label}${span}. ${now_}${focus === "fl" || focus === "line" || !p.inService ? fl : ""}`);
              if (p.soon.length) out.push(`${p.soon.map(s => s.name).join(" and ")} ${p.soon.length > 1 ? "open" : "opens"} ${p.soon[0].opens}.`);
            }
            if (focus === "line" && F.fleet.length) out.push(`Trains: ${F.fleet.map(f => f[0]).join(", ")}.`);
            if (focus === "hist" && H) out.push(`${hSoon(H.opened) ? "Expected to open" : "Opened"} ${hDate(H.opened)}.`, ...H.story.slice(0, 2));
            return out.join("\n");
          }
          function aStatusText(k){
            const s = aStatus(k);
            if (!s.known) return s.note;
            if (!s.disrupted) return `LTA isn't reporting any disruption${k ? ` on the ${aLineName(k)}` : ""} (last checked ${s.checked}).`;
            return `**Disruption reported by LTA**\n${s.segments.map(sg => `- ${sg.line}${sg.direction ? `, ${sg.direction.toLowerCase() === "both" ? "both directions" : "towards " + sg.direction}` : ""}: ${sg.stations.length > 1 ? `${sg.stations[0]} to ${sg.stations[sg.stations.length - 1]}` : sg.stations[0] || ""}${sg.freeBusesAt.length ? `. Free buses at ${sg.freeBusesAt.slice(0, 4).join(", ")}${sg.freeBusesAt.length > 4 ? "…" : ""}` : ""}`).join("\n")}${s.messages[0] ? "\n" + s.messages[0].slice(0, 400) : ""}`;
          }
          function aBusyText(k){
            const b = aBusiest(k);
            if (!b) return aCrowdNote();
            if (!b.stations.length) return `Platform crowds are low everywhere${k ? ` on the ${aLineName(k)}` : ""} (LTA, ${b.window}).`;
            return `**Busiest platforms now** (LTA, ${b.window})\n${b.stations.slice(0, 8).map(s => `- ${s.name}: ${s.level}`).join("\n")}`;
          }
          function aRouteText(a, b, now){
            const r = aRoute(a, b, now);
            if (!r) return `I couldn't find a train route from ${a.name} to ${b.name}${a.codes.every(x => x.idx >= activeStations(LINES[x.line], now.iso).length) || b.codes.every(x => x.idx >= activeStations(LINES[x.line], now.iso).length) ? ", because one of them isn't open yet" : ""}.`;
            const steps = r.legs.map(l => l.line
              ? `- ${aLineChip(l.line)} towards ${l.toward}: ${l.from} to ${l.to}, ${l.stops} stop${l.stops === 1 ? "" : "s"}${l.next != null ? ` (next train ${aWhen(l.next, now)})` : l.noMore ? ` (no more trains go as far as ${l.to} ${now.mins >= 18 * 60 ? "tonight" : "today"})` : ""}`
              : `- ${l.walk ? `Walk from ${l.at} to ${l.to}` : `Change at ${l.at}`}`);
            return `**${r.from} to ${r.to}** · about ${Math.round(r.mins)} min${r.changes > 0 ? `, ${r.changes} change${r.changes > 1 ? "s" : ""}` : ", no changes"}\n${steps.join("\n")}\nRough travel time from the usual schedule${r.changes > 0 ? `, with about ${A_CHANGE} min for each change` : ""}. It doesn't include waiting for the first train.`;
          }
          function aModelText(m){
            const f = aModelFacts(m);
            return `**${m}** · ${f.maker}\n${f.status}${f.now ? `: ${f.now}` : ""} · ${f.lines.join(", ")}${f.retired ? ` · retired ${f.retired}` : ""}\n${f.story}`;
          }
          const aWxNote = () => !APP ? "Live weather comes from NEA through the MRT Dev phone app, so this web version doesn't have it." : "Live weather from NEA isn't available right now.";
          function aWeatherText(e){
            if (!wxFresh()) return aWxNote();
            if (e){
              const w = wxAt(e.x, e.y);
              return `**Weather at ${e.name}** (${w.area})\n${w.rainNow != null ? `${w.rainNow > 0 ? `It's raining now: ${w.rainText}, ${w.rainNow} mm in 5 min` : "No rain right now"} at the ${w.gauge} gauge.` : "No rain gauge nearby."}${w.lightningNearby ? " Lightning has been detected nearby." : ""}\nForecast: ${w.forecast}${w.period ? ` (${w.period})` : ""}.${w.temp != null ? ` ${w.temp.toFixed(1)}°C.` : ""}\nFrom NEA, updated ${wxClock(wx.at)}.`;
            }
            const I = wxIsland();
            return `**Weather across Singapore**\n${I.wetAreas.length ? `Showers or rain forecast for ${I.wetAreas.length} of ${I.areas} areas, including ${I.wetAreas.slice(0, 4).join(", ")}${I.wetAreas.length > 4 ? "…" : ""}` : "No rain forecast"}${I.period ? ` (${I.period})` : ""}.${I.rainingGauges ? ` ${I.rainingGauges} rain gauges are measuring rain now.` : ""}${I.lightning ? " Lightning detected." : ""}${I.tempRange ? ` ${Math.round(I.tempRange[0])}–${Math.round(I.tempRange[1])}°C.` : ""}\nFrom NEA, updated ${wxClock(wx.at)}.`;
          }
          const A_HELP = "I can answer questions about Singapore's MRT and LRT from the app's own data: next trains, first and last trains, routes between stations, how often trains come, platform crowds, disruptions, and the history of stations, lines and train models.";
          const A_FARE = /\b(fares?|costs?|price|tickets?|ez ?link|simplygo|concession)\b|\bhow much\b(?! (time|longer|later))/;
          const A_FACIL = /\b(exits?|toilets?|restrooms?|lifts?|elevators?|escalators?|parking|wifi|atm|food|shops?|bus(es)? (number|service|stop)s?)\b/;

          function aBuiltin(q){
            const now = sgNow(), n = aNorm(q), S = aScan(q), st = S.stations, ln = S.lines[0] || null, md = S.models[0] || null;
            const acts = [];
            const stAct = e => { acts.push({t: "map", v: e.name, label: `Show ${e.name} on map`}); if (H_STN[e.name] || aOpened(e).length) acts.push({t: "hst", v: e.name, label: "Station history"}); };
            const lnAct = k => { const c = aCodesOf(k)[0]; if (c) acts.push({t: "board", v: c, label: "Open Line Board"}); if (H_LINE[H_KEY(k)]) acts.push({t: "hln", v: H_KEY(k), label: "Line history"}); };
            const out = text => ({text, acts: acts.slice(0, 3)});
            if (!n) return out(A_HELP);
            if (/^(hi|hello|hey|yo|hiya|good (morning|afternoon|evening|night))\b/.test(n) && !st.length && !ln && !md) return out("Hi! " + A_HELP);
            if (/^(thanks?|thank you|ty|ok|okay|cool|nice|great)\b/.test(n) && n.split(" ").length <= 4) return out("You're welcome. Ask me anything else about the trains.");
            if (/\b(help|what can you (do|answer)|who are you|what are you)\b/.test(n) && !st.length && !ln) return out(A_HELP);
            if (S.nothere.length && !st.length) return out(`The ${S.nothere[0]} isn't open yet, so the app doesn't track it.`);

            if (/\b(weather|rain\w*|umbrella|storm\w*|thunder\w*|lightning|temperature|haz[ey]|cloudy|sunny|drizzl\w*|showers?|forecast)\b|\bhow hot\b/.test(n)){
              if (st[0]) stAct(st[0]);
              return out(aWeatherText(st[0] || null));
            }
            const FL = /\b(first|last|earliest|latest|final) (train|trains|mrt|service|one)\b|\b(operating|opening|service) hours\b|\bwhat time (does|do|is|will) .*\b(start|end|stop|close|run)\b|\buntil what time\b|\bhow late\b/.test(n);
            const STATUS = /\b(disrupt\w*|delay\w*|breakdown|broke|faults?|faulty|down|working|normal\w*|status|issues?|problems?|alerts?|stuck|suspend\w*|running (ok|okay|fine|properly))\b/.test(n) || /^(is|are|any)\b.*\b(ok|okay|fine|alright|running)$/.test(n);
            const CROWD = /\b(crowd\w*|busy|busiest|packed|full|squeez\w*|congest\w*|how many people|peak hour)\b/.test(n);
            const HIST = /\b(history|historic\w*|opened|built|story|named|called|origin|when did|how old|old is|backstory|background)\b/.test(n);
            const SOON = /\b(when will|when is .* open|open(ing)? date|opens|be open)\b/.test(n);
            const FREQ = /\b(how often|frequen\w*|interval|headway|every how|how many trains|trains running|trains are running|gap between)\b/.test(n);
            const NEXT = /\b(next|when|arriv\w*|coming|wait\w*|eta|timings?|how long|leav\w*|depart\w*|train|trains)\b/.test(n);
            const ROUTE = st.length >= 2 && /\b(from|to|get|go|going|travel|route|way|reach|direction|directions|change|transfer)\b/.test(n);

            if (A_FARE.test(n)){
              const extra = ROUTE ? "\n\n" + aRouteText(S.from || st[0], st.find(e => e !== (S.from || st[0])), now) : "";
              if (ROUTE){ stAct(st[0]); }
              return out(`The app doesn't have fares. You can check them on SimplyGo (simplygo.com.sg) or LTA's MyTransport.SG app.${extra}`);
            }
            if (/\b(live ?cams?|rail ?cam|railcamsg|live ?streams?|webcam|camera)\b/.test(n))
              return out(`The **Live cam** tab plays RailCam Singapore's live stream from YouTube (youtube.com/@railcamsg). ${camApp() ? "The app looks for the channel's live stream every 3 minutes while the tab is open and starts it by itself; when there's none, it lists the latest videos." : "In the MRT Tracker app it also finds new streams by itself."}`);
            if (/\b(special[- ]?bound|short[- ]?(trip|trips|working)|(end|ends|ending|terminat\w*) (early|halfway|partway|midway|before)|turn(s|ing)? back)\b/.test(n)){
              if (ln) lnAct(ln);
              return out(aShortText(ln));
            }
            if (A_FACIL.test(n) && st.length){ stAct(st[0]); return out(`The app doesn't have exits or facilities for ${st[0].name}. SMRT (smrt.com.sg) and SBS Transit (sbstransit.com.sg) list them on each station's page.`); }

            // "next train at Bishan to Jurong East": the second station is just the direction
            if (st.length >= 2 && NEXT && !/\b(from|get|go|going|travel|route|reach)\b/.test(n)){
              const rows = aStationTrains(st[0], now);
              if (rows.some(r => r.toward && r.toward.startsWith(st[1].name))){ stAct(st[0]); return out(aTrainsText(st[0], now, ln, st[1])); }
            }
            if (ROUTE){
              const a = S.from || st[0], b = st.find(e => e !== a);
              acts.push({t: "map", v: a.name, label: `Show ${a.name} on map`}, {t: "map", v: b.name, label: `Show ${b.name} on map`});
              return out(aRouteText(a, b, now));
            }
            if (md && !st.length){ acts.push({t: "hmd", v: md, label: `${md} history`}); return out(aModelText(md)); }
            if (STATUS && !FL){
              if (ln) lnAct(ln); else if (st[0]) stAct(st[0]);
              if (st[0] && !ln){
                const s0 = aStatus(null);
                if (!s0.known) return out(s0.note);
                if (aDisrupted(st[0])) return out(`Yes. LTA is reporting a disruption that affects ${st[0].name}.\n${aStatusText(null)}`);
                return out(`LTA isn't reporting any disruption at ${st[0].name} (last checked ${s0.checked}).${s0.disrupted ? `\nThere is one elsewhere: ${s0.segments.map(sg => `${sg.line}, ${sg.stations[0]}${sg.stations.length > 1 ? " to " + sg.stations[sg.stations.length - 1] : ""}`).join("; ")}.` : ""}`);
              }
              return out(aStatusText(ln || null));
            }
            if (CROWD){
              if (st[0]){ stAct(st[0]); return out(aCrowdText(st[0])); }
              if (ln) lnAct(ln);
              return out(aBusyText(ln));
            }
            if (FL){
              if (st[0]){ stAct(st[0]); return out(aFirstLastText(st[0], now, ln)); }
              if (ln){ lnAct(ln); return out(aLineText(ln, now, "fl")); }
            }
            if ((HIST || SOON) && st[0] && !ln){ stAct(st[0]); return out(aStationHistText(st[0])); }
            if ((HIST || SOON) && ln && !st[0]){ lnAct(ln); return out(aLineText(ln, now, "hist")); }
            if (FREQ && ln){ lnAct(ln); return out(aLineText(ln, now, "freq")); }
            if (st[0]){
              stAct(st[0]);
              const extra = [];
              const c = aCrowd(st[0]); if (c && !NEXT) extra.push(`Platform crowds (LTA, ${c.window}): ${c.levels.map(l => `${l.code} ${l.level.toLowerCase()}`).join(", ")}.`);
              if (aDisrupted(st[0])) extra.push("LTA is reporting a disruption here. Open Updates for details.");
              return out(aTrainsText(st[0], now, ln) + (extra.length ? "\n" + extra.join("\n") : ""));
            }
            if (ln){ lnAct(ln); return out(aLineText(ln, now, "line")); }
            if (md){ acts.push({t: "hmd", v: md, label: `${md} history`}); return out(aModelText(md)); }
            if (STATUS) return out(aStatusText(null));
            if (CROWD) return out(aBusyText(null));
            if (n.split(" ").length <= 3){
              const f = aFindStation(q);
              if (f.e){ stAct(f.e); return out(aTrainsText(f.e, now)); }
              if (f.choices) return out(`Did you mean ${f.choices.slice(0, -1).join(", ")}${f.choices.length > 1 ? " or " : ""}${f.choices[f.choices.length - 1]}?`);
            }
            return out("I'm not sure which station or line you mean. Try a station name or code (like Bishan or NS17), a line (like the Circle Line), or a train model (like the R151).");
          }

          /* ---- Claude ---- */
          const A_TOOLS = [
            {name: "station_info", description: "Live and reference facts for one station: its codes and lines, the next trains each way (from now), today's first and last trains, LTA's live platform crowd level, whether LTA reports a disruption there, and when it opened. Pass a station name or code, like \"Bishan\" or \"NS17\".",
              schema: {type: "object", properties: {station: {type: "string", description: "Station name or code"}}, required: ["station"]},
              run: i => {
                const f = aFindStation(String(i.station || ""));
                if (!f.e) return f.choices ? {error: "Which station?", choices: f.choices} : {error: "No station by that name in the app."};
                const e = f.e, now = sgNow();
                return {timetableFor: dayText(now), name: e.name, codes: [...new Set(e.codes.map(x => x.code))], lines: [...new Set(e.codes.map(x => aLineChip(x.line)))],
                  trains: aStationTrains(e, now).map(r => r.opens ? {code: r.code, opens: r.opens} : {line: aLineChip(r.line), code: r.code, towards: r.toward,
                    next: r.mins.map((m, k) => aWhen(m, now) + (r.ends[k] ? ` (special-bound: ends at ${r.ends[k]})` : "")), firstToday: r.first != null ? clockText(r.first) : null, lastToday: r.last != null ? clockText(r.last) : null,
                    firstTomorrow: r.tomorrow != null ? clockText(r.tomorrow) : null, times: r.src}),
                  crowd: aCrowd(e) || aCrowdNote(), disruptionHere: alertState ? aDisrupted(e) : "unknown", opening: aOpened(e), history: H_STN[e.name] || null};
              }},
            {name: "line_info", description: "Facts for one line: how many stations and where it runs, trains running right now and how often, first and last trains, stations opening soon, its trains, operator, opening date and a short history. Pass a line name or code, like \"Circle Line\", \"NSL\", \"Sengkang LRT\", \"Sentosa Express\" or \"RTS Link\".",
              schema: {type: "object", properties: {line: {type: "string", description: "Line name or code"}}, required: ["line"]},
              run: i => {
                const k = aFindLine(String(i.line || "")); if (!k) return {error: "No line by that name in the app. Lines: " + H_ORDER.map(x => H_LINE[x].name).join(", ")};
                const F = aLineFacts(k, sgNow()), H = F.H;
                return {timetableFor: dayText(sgNow()), name: F.name, operator: F.op, opened: F.opened ? hDate(F.opened) : null, driverless: F.driverless,
                  parts: F.parts.map(p => p.open ? {name: p.name, stations: p.stations, runs: p.loop ? `loop from ${p.from}` : `${p.from} to ${p.to}`,
                    inServiceNow: p.inService, trainsRunningNow: p.running, everyMinutes: p.every, times: p.src,
                    firstTrain: p.firstA != null ? clockText(Math.min(p.firstA, p.firstB ?? Infinity)) : null, lastTrain: p.lastA != null ? clockText(Math.max(p.lastA, p.lastB ?? -Infinity)) : null,
                    openingSoon: p.soon} : {name: p.name, notOpenYet: true, expected: p.opens}),
                  trains: F.fleet.map(f => ({model: f[0], maker: f[1], fleet: `${f[3]} ${typeof f[2] === "number" ? `${f[2]}-car trains` : "cars"}`, since: f[4]})),
                  history: H ? H.story.join(" ") : null, future: H && H.future || null};
              }},
            {name: "plan_route", description: "The quickest MRT/LRT route between two stations: which lines, where to change, stops on each, rough travel time, and when the first train leaves. Pass station names or codes.",
              schema: {type: "object", properties: {from: {type: "string"}, to: {type: "string"}}, required: ["from", "to"]},
              run: i => {
                const a = aFindStation(String(i.from || "")), b = aFindStation(String(i.to || ""));
                if (!a.e || !b.e) return {error: "Couldn't find " + (!a.e ? `"${i.from}"` : `"${i.to}"`), choices: (!a.e ? a.choices : b.choices) || []};
                const now = sgNow(), r = aRoute(a.e, b.e, now);
                if (!r) return {error: "No train route between those stations (one may not be open yet)."};
                return {from: r.from, to: r.to, aboutMinutes: Math.round(r.mins), changes: r.changes, note: `Rough time from the usual schedule, with about ${A_CHANGE} min per change; excludes the first wait.`,
                  legs: r.legs.map(l => l.line ? {line: aLineChip(l.line), towards: l.toward, from: l.from, to: l.to, stops: l.stops, nextTrain: l.next != null ? aWhen(l.next, now) : l.noMore ? "no more trains go that far today" : undefined}
                    : {[l.walk ? "walk" : "change"]: l.walk ? `${l.at} to ${l.to}` : l.at})};
              }},
            {name: "train_model", description: "History and facts for a train model the app knows, like \"R151\", \"C151A\", \"T251\" or \"C830C\". Leave model empty to list them all.",
              schema: {type: "object", properties: {model: {type: "string"}}},
              run: i => {
                const want = aNorm(i.model || "").replace(/\s/g, "");
                if (!want) return {models: Object.keys(H_MODEL).map(m => `${m} (${hStatus(m)[0]})`)};
                const m = Object.keys(H_MODEL).find(x => aNorm(x).replace(/\s/g, "") === want) || Object.keys(H_MODEL).find(x => aNorm(x).replace(/\s/g, "").includes(want));
                return m ? aModelFacts(m) : {error: "Unknown model", models: Object.keys(H_MODEL)};
              }},
            {name: "weather", description: "Live weather from Singapore's National Environment Agency: the 2-hour forecast, rain measured right now, temperature and wind, near one station, or across Singapore when no station is given.",
              schema: {type: "object", properties: {station: {type: "string", description: "Optional station name or code"}}},
              run: i => {
                if (!wxFresh()) return {note: aWxNote()};
                if (i.station){ const f = aFindStation(String(i.station)); if (!f.e) return {error: "No station by that name", choices: f.choices || []};
                  return {station: f.e.name, ...wxAt(f.e.x, f.e.y), updated: wxClock(wx.at)}; }
                return {...wxIsland(), updated: wxClock(wx.at)};
              }},
            {name: "service_status", description: "Live disruption alerts from LTA right now, for the whole network or one line.",
              schema: {type: "object", properties: {line: {type: "string", description: "Optional line name or code"}}},
              run: i => aStatus(i.line ? aFindLine(String(i.line)) : null)},
            {name: "busiest_stations", description: "Stations where LTA's live platform crowd level is high or moderate right now, for the whole network or one line.",
              schema: {type: "object", properties: {line: {type: "string", description: "Optional line name or code"}}},
              run: i => aBusiest(i.line ? aFindLine(String(i.line)) : null) || {note: aCrowdNote()}}
          ];
          const aRunTool = (name, input) => { const t = A_TOOLS.find(x => x.name === name); if (!t) throw new Error("Unknown tool"); return t.run(input || {}); };
          function aRules(){
            const n = sgNow(), d = new Date(simNow() + 8 * 3600e3);
            const day = d.toLocaleDateString("en-GB", {weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "UTC"});
