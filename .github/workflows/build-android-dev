            $("tabs").innerHTML = ORDER.map(c => (c==="BP" ? '<span class="tabsep">LRT</span>' : c==="SEN" ? '<span class="tabsep">Monorail</span>' : c==="RTS" ? '<span class="tabsep">Cross-border</span>' : "") +
              `<button class="tab" role="tab" id="tab-${c}" style="--c:var(--${c})" aria-selected="${c===current}" data-c="${c}">
                 <span class="sw"></span>${c==="CG"?"Changi branch":(LINES[c].tab||c)}</button>`).join("");
            window.afterTabs && afterTabs();
            $("tabs").onclick = e => { const b = e.target.closest(".tab"); if (b) select(b.dataset.c); };
            $("stations").innerHTML = Object.keys(byName).sort().map(n => `<option value="${n}">`).join("");
          }
          function select(c, stationName){
            current = c; openIdx = -1;
            try { history.replaceState(null, "", "#" + c.toLowerCase()); } catch(e){ location.hash = c.toLowerCase(); }
            document.querySelectorAll(".tab").forEach(t => t.setAttribute("aria-selected", t.dataset.c === c));
            $("tab-"+c).scrollIntoView({inline:"nearest", block:"nearest"});
            buildBoard();
            if (stationName){
              const i = LINES[c].stations.findIndex(s => s[1] === stationName);
              if (i >= 0){ openIdx = i; tick(); const r = $("board").children[i+1]; r && r.scrollIntoView({block:"center", behavior:"smooth"}); }
            }
          }

          function buildBoard(){
            const L = LINES[current], now = sgNow(), act = activeStations(L, now.iso).length;
            const color = `var(--${current})`;
            document.documentElement.style.setProperty("--c", color);
            $("board").style.setProperty("--c", color);
            renderFleet(current);
            const actList = act ? L.stations.slice(0, act) : L.stations;
            $("lgA").textContent = "↓ To " + dest(L, 0, actList);
            $("lgB").textContent = "To " + dest(L, 1, actList) + " ↑";
            const rows = L.stations.map((s, i) => {
              const others = (byName[s[1]] || []).filter(x => x[0] !== current);
              const fut = i >= act;
              return `<div class="row${others.length?" ix":""}${fut?" future":""}" tabindex="0" data-i="${i}">
                <span class="dot"></span>
                <div class="st">
                  <div class="name"><span class="code">${s[0]}</span>${s[1]}
                    ${others.map(o => `<span class="code sm" style="background:var(--${o[0]})">${o[1]}</span>`).join("")}${fut ? "" : `<span class="cwd-slot" data-code="${s[0]}"></span>`}</div>
                  <div class="next" id="nx${i}"></div>
                  <div class="detail" id="dt${i}" hidden></div>
                </div></div>`;
            }).join("");
            $("board").innerHTML = `<div class="lanes" id="lanes"><div class="spine" id="spine"></div><div class="spine future" id="spineF" hidden></div></div>` + rows;
            $("board").onclick = e => {
              const h = e.target.closest("[data-hstation]"); if (h){ histOpen("station", h.dataset.hstation); return; }
              const r = e.target.closest(".row"); if (r) toggle(+r.dataset.i);
            };
            $("board").onkeydown = e => { if ((e.key==="Enter"||e.key===" ") && e.target.classList.contains("row")){ e.preventDefault(); toggle(+e.target.dataset.i); } };
            trainEls = {};
            if (typeof crowd !== "undefined") paintCrowd();   // crowd figures are set up after the map, further down
            window.afterBoard && afterBoard();
            layoutSpine();
            tick();
          }
          function toggle(i){
            const L = LINES[current];
            if (i >= activeStations(L, sgNow().iso).length) return;
            openIdx = openIdx === i ? -1 : i; tick();
            if (openIdx >= 0 && window.syncMapStation){ window.syncMapStation(L.stations[i][1]); }
          }

          let rowCenters = [];
          function layoutSpine(){
            const rows = [...$("board").querySelectorAll(".row")];
            const top0 = $("lanes").getBoundingClientRect().top;
            rowCenters = rows.map(r => { const b = r.getBoundingClientRect(); return b.top - top0 + Math.min(b.height, parseFloat(getComputedStyle(r).getPropertyValue("--rowh"))||54)/2; });
            const act = activeStations(LINES[current], sgNow().iso).length;
            const sp = $("spine"); sp.hidden = act < 2; sp.style.top = rowCenters[0]+"px"; sp.style.height = (rowCenters[Math.max(0, act-1)]-rowCenters[0])+"px";
            const f = $("spineF"), from = rowCenters[Math.max(0, act-1)];
            if (act < rows.length){ f.hidden = false; f.style.top = from+"px"; f.style.height = (rowCenters[rows.length-1]-from)+"px"; }
            else f.hidden = true;
          }
          function yAt(idx){
            const i = Math.floor(idx), f = idx - i;
            const a = rowCenters[i], b = rowCenters[Math.min(i+1, rowCenters.length-1)];
            return a + (b - a) * f - 11;
          }

          let trainEls = {}, selTrain = null;
          /* Front view of a train; the small arrow shows its direction of travel. */
          function trainSVG(dir){
            const arrow = dir ? '<path class="arrow" d="M11 0 L15 3.5 H7 Z"/>' : '<path class="arrow" d="M11 26 L15 22.5 H7 Z"/>';
            return `<svg class="tic" viewBox="0 0 22 26" aria-hidden="true">${arrow}
              <rect class="body" x="2.5" y="4" width="17" height="18" rx="5"/>
              <rect class="win" x="5.5" y="7" width="11" height="6" rx="1.5"/>
              <circle class="lamp" cx="7" cy="17.5" r="1.5"/><circle class="lamp" cx="15" cy="17.5" r="1.5"/></svg>`;
          }
          function tick(){
            const now = sgNow(), L = LINES[current], act = activeStations(L, now.iso);
            $("clock").textContent = now.clock;

            // status card
            const running = trainsOn(current, now);
            const t = now.mins, official = usesTT(current);
            const hw = official ? ttHeadway(current, now) : headway(L, t, now.weekend, current, 0, dayOf(now));
            const [h0, h1] = serviceSpan(current, dayOf(now));
            const inService = official ? running.length > 0 : t >= h0 && t <= h1;
            const peak = isPeak(t, now.weekend) && t < 23*60;
            const hwText = hw == null ? null : hw < 10 && Math.abs(hw * 2 - Math.round(hw * 2)) < 0.05 ? Math.round(hw * 2) / 2 : Math.round(hw);
            const first = official ? ttFirstTrain(current, now) : null;
            // after midnight the next first trains are the next day's, which may be a weekend or holiday
            const nextDay = t >= 1440 ? aNextDay(now) : now;
            const firstEst = L.hours ? L.firstText : clockText(serviceSpan(current, dayOf(nextDay))[0]).replace(":", ".");
            const closed = official && first != null && t < first ? `No trains yet · first train at ${clockText(first)}` : `Closed for the night · first trains from ${firstEst}`;
            const notOpen = !act.length;
            setHTML($("status"), `<div class="bar" style="background:var(--${current})"></div>
              <b>${L.name}</b><button type="button" class="hb" data-hline="${current}">History</button>
              ${notOpen ? `<span>Not open yet · passenger service expected ${opensText(L, L.stations[0]).replace(" (expected)", "")}</span>` : `<span>${inService ? `${running.length} train${running.length === 1 ? "" : "s"} running${hwText != null ? ` · every ${hwText} min` : ""}${peak ? " (peak)" : ""}${!official && L.shuttle ? ` · ${shuttleTrains(L, t, now.weekend)}-train shuttle` : ""}` : closed}
                · <span class="src">${official ? "LTA timetable" : "estimated"} for ${dayText(now)}</span></span>`}`);
            const fut = L.stations.filter(s => s[2] && now.iso < s[2]);
            $("notice").innerHTML = notOpen ? `<div class="notice">The ${L.name} isn't open yet. Trains between ${L.stations[0][1]} and ${L.stations[L.stations.length-1][1]} are expected to start ${opensText(L, L.stations[0]).replace(" (expected)", "")}.</div>`
              : fut.length ? `<div class="notice">${fut.map(s=>s[1]).join(" and ")} ${fut.length > 1 ? "open" : "opens"} ${opensText(L, fut[0])}.</div>` : "";

            // per-station next trains
            const n = act.length;
            for (let i = 0; i < L.stations.length; i++){
              const nx = $("nx"+i), dt = $("dt"+i), row = nx.closest(".row");
              if (i >= n){ nx.textContent = opensText(L, L.stations[i], true); continue; }
              const a = i < n-1 ? nextArrivals(current, i, 0, now, 3) : [];
              const b = i > 0 ? nextArrivals(current, i, 1, now, 3) : [];
              // a special-bound next train shows the code of the station it ends at
              const sbc = (d, arr) => arr.length && isShortTo(L, d, act, arr.to[0]) ? `<i class="sbc" title="Ends at ${esc(act[arr.to[0]][1])}">→${act[arr.to[0]][0]}</i>` : "";
              nx.innerHTML = `<span>${a.length ? "↓ <em>"+fmt(a[0])+"</em>"+sbc(0, a) : "&nbsp;"}</span><span>${b.length ? "↑ <em>"+fmt(b[0])+"</em>"+sbc(1, b) : "&nbsp;"}</span>`;
              row.classList.toggle("open", i === openIdx);
              if (i === openIdx){
                dt.hidden = false;
                // like a platform display: the next trains grouped by where they're going, special-bound ones on their own row
                let anyShort = false;
                const line = (d, arr) => {
                  if (!arr.length) return `<div><span>To ${dest(L, d, act)}</span><span class="t">No more trains</span></div>`;
                  const groups = [];
                  arr.forEach((m, k) => {
                    const sb = isShortTo(L, d, act, arr.to[k]), name = sb ? act[arr.to[k]][1] : dest(L, d, act);
                    let g = groups.find(x => x.name === name); if (!g) groups.push(g = {name, sb, ms: []});
                    g.ms.push(m); if (sb) anyShort = true;
                  });
                  return groups.map(g => `<div${g.sb ? ' class="sbrow"' : ""}><span>To ${esc(g.name)}${g.sb ? `<span class="sb">special-bound</span>` : ""}</span><span class="t">${g.ms.map(fmt).join(" · ")}</span></div>`).join("");
                };
                const rows = (i < n-1 ? line(0, a) : "") + (i > 0 ? line(1, b) : "");
                setHTML(dt, rows + (anyShort ? `<p class="sbnote">Special-bound trains end at that station instead of going all the way.</p>` : "") +
                  `<div class="dact"><button type="button" class="hlink" data-hstation="${esc(L.stations[i][1])}">Station history ›</button></div>`);
              } else dt.hidden = true;
            }

            layoutSpine();
            // trains
            const seen = new Set();
            for (const tr of running){
              seen.add(tr.id);
              let el = trainEls[tr.id];
              if (!el){
                el = document.createElement("button"); el.className = "train d" + tr.dir; el.type = "button";
                el.innerHTML = trainSVG(tr.dir);
                el.onclick = ev => { ev.stopPropagation(); selTrain = selTrain === tr.id ? null : tr.id; tick(); };
                el._dep = tr.dep; el._dir = tr.dir; el._ref = tr.ref || null; el._a = tr.a || 0; el._b = tr.b;
                el.classList.toggle("short", isShortTo(L, tr.dir, act, tr.to));
                el.style.setProperty("--d", (-(tr.dep * 7.3) % 2).toFixed(2) + "s");   // stagger the pulses
                $("lanes").appendChild(el); trainEls[tr.id] = el;
                el.style.transform = `translateY(${yAt(tr.idx)}px)`;
              }
              el.classList.toggle("moving", !tr.atStation);
              el.classList.toggle("dwell", tr.atStation);
            }
            for (const id in trainEls) if (!seen.has(id)){ trainEls[id].remove(); delete trainEls[id]; }

            // labels and the selected-train card
            const terminus = tr => destOf(L, tr.dir, act, tr.to);
            for (const tr of running){
              const el = trainEls[tr.id], stop = act[tr.next][1];
              el.setAttribute("aria-label", `Train to ${terminus(tr)}${isShortTo(L, tr.dir, act, tr.to) ? " (special-bound)" : ""}, ${tr.atStation ? "at" : "next stop"} ${stop}`);
              el.classList.toggle("sel", tr.id === selTrain);
            }
            const s = running.find(tr => tr.id === selTrain);
            if (!s){
              if (selTrain) selTrain = null;
              $("trainInfo").innerHTML = `<p class="hint">${running.length ? "Tap a train to see where it's heading." : "No trains running right now."}</p>`;
            } else {
              const stop = act[s.next][1];
              const where = s.atStation ? `Now at <b>${stop}</b>` : `Next stop <b>${stop}</b>`;
              $("trainInfo").innerHTML = `<div class="tinfo">
                <div>${trainSVG(s.dir)}</div>
                <div>Train to <b>${terminus(s)}</b>${isShortTo(L, s.dir, act, s.to) ? `<span class="sb">special-bound</span>` : ""}<br>${where}</div>
                <span class="eta">${s.atStation ? "Boarding" : s.eta < 0.5 ? "Arriving" : "~" + Math.max(1, Math.round(s.eta)) + " min"}</span>
                <button type="button" aria-label="Close" id="tclose">×</button></div>`;
              $("tclose").onclick = () => { selTrain = null; tick(); };
            }
            window.afterTick && afterTick();
          }


          /* ---------- Custom Instant Search & Station Picker ---------- */
          const findIn = $("find"), findDrop = $("searchDrop"), findClear = $("findClear");
          function pickStation(name, preferredLine){
            if (!name || !byName[name]) return;
            findIn.value = name;
            findClear.hidden = false;
            findDrop.hidden = true;
            const lines = byName[name].map(x => x[0]);
            const targetLine = preferredLine && lines.includes(preferredLine) ? preferredLine : (lines.includes(current) ? current : lines[0]);
            select(targetLine, name);
            if (window.mapFocus) window.mapFocus(name);
            findIn.blur();
          }
          function updateSearchDrop(){
            const q = findIn.value.trim().toLowerCase();
            findClear.hidden = !q;
            if (!q){ findDrop.hidden = true; return; }
            const matches = Object.keys(byName).filter(n => {
              if (n.toLowerCase().includes(q)) return true;
              return byName[n].some(x => x[1].toLowerCase().includes(q));
            }).sort((a, b) => {
              const aStarts = a.toLowerCase().startsWith(q) ? 0 : 1;
              const bStarts = b.toLowerCase().startsWith(q) ? 0 : 1;
              return aStarts - bStarts || a.localeCompare(b);
            }).slice(0, 10);
            if (!matches.length){
              findDrop.innerHTML = `<div class="s-item" style="color:var(--muted);cursor:default">No matching stations</div>`;
              findDrop.hidden = false;
              return;
            }
            findDrop.innerHTML = matches.map(n => {
              const badges = byName[n].map(([lc, code]) => `<span class="code sm" style="background:var(--${lc})">${code}</span>`).join("");
              return `<button type="button" class="s-item" data-st="${n.replace(/"/g, '&quot;')}"><span><b>${n}</b></span><span class="s-badges">${badges}</span></button>`;
            }).join("");
            findDrop.hidden = false;
          }
          findIn.addEventListener("input", updateSearchDrop);
          findIn.addEventListener("focus", updateSearchDrop);
          findIn.addEventListener("keydown", e => {
            if (e.key === "Enter"){
              const first = findDrop.querySelector(".s-item[data-st]");
              if (first){ e.preventDefault(); pickStation(first.dataset.st); }
            } else if (e.key === "Escape"){
              findDrop.hidden = true; findIn.blur();
            }
          });
          findClear.onclick = () => { findIn.value = ""; findClear.hidden = true; findDrop.hidden = true; findIn.focus(); };
          findDrop.addEventListener("click", e => {
            const btn = e.target.closest(".s-item[data-st]");
            if (btn) pickStation(btn.dataset.st);
          });
          document.addEventListener("click", e => {
            if (!e.target.closest("#searchBox")) findDrop.hidden = true;
          });
          document.addEventListener("keydown", e => {
            if (e.key === "/" && document.activeElement !== findIn && !["INPUT","TEXTAREA"].includes(document.activeElement?.tagName)){
              e.preventDefault(); findIn.focus();
            }
          });

          window.addEventListener("hashchange", () => { const c = location.hash.slice(1).toUpperCase(); if (LINES[c] && c !== current) select(c); });
          window.addEventListener("resize", () => { layoutSpine(); tick(); });
          document.fonts && document.fonts.ready.then(() => { layoutSpine(); tick(); });

          buildTabs(); buildBoard();
          setInterval(tick, 1000);

          /* Smooth motion: reposition every train on every frame from the timetable. */
          function trainIdx(L, n, dep, dir, mins, run = L.run, a = 0, b = n - 1){
            const lg = run + L.dwell, e = Math.max(a ? a*lg - L.dwell : 0, Math.min(mins - dep, b*lg));
            const seg = Math.min(Math.floor(e/lg), b-1), within = e - seg*lg;
            const pos = seg + Math.min(1, within / run);
            return dir ? (n-1) - pos : pos;
          }
          (function frame(){
            const L = LINES[current], now = sgNow(), n = activeStations(L, now.iso).length;
            for (const id in trainEls){
              const el = trainEls[id];
              let idx;
              if (el._ref){ const st = ttState(el._ref, now.mins * 60); if (!st) continue; idx = st.idx; }
              else idx = trainIdx(L, n, el._dep, el._dir, now.mins, runOf(current, el._dir), el._a, el._b ?? n - 1);
              el.style.transform = `translateY(${yAt(idx).toFixed(2)}px)`;
            }
            requestAnimationFrame(frame);
          })();

          /* ---------- Live disruption alerts, news and settings ----------
             In the Android app, a native bridge (window.MrtApp) fetches LTA DataMall and news feeds,
             because a web page can't call those sites directly. In a browser, the Updates tab shows
             a clearly labelled sample instead. */
          const APP = window.MrtApp || null;
          const APP_CHANNEL = (() => { try { return APP && APP.getChannel ? String(APP.getChannel()) : "web"; } catch(e){ return "web"; } })();
          const DATAMALL = "https://datamall2.mytransport.sg/ltaodataservice/TrainServiceAlerts";
          /* LTA line codes (API guide v6.11, section 2.11) → this tracker's lines.
             EWL includes the Changi Airport branch, CCL includes Bayfront, and each LRT system is one code. */
          const LINES_FROM_LTA = {NSL:["NSL"],EWL:["EWL","CG"],NEL:["NEL"],CCL:["CCL"],DTL:["DTL"],TEL:["TEL"],BPL:["BP"],STL:["SE","SW"],PTL:["PE","PW"],
            CGL:["CG"],CEL:["CCL"],SEL:["SE"],SWL:["SW"],PEL:["PE"],PWL:["PW"]};
          const LINE_NAME_LTA = {NSL:"North-South Line",EWL:"East-West Line",NEL:"North East Line",CCL:"Circle Line",DTL:"Downtown Line",TEL:"Thomson-East Coast Line",BPL:"Bukit Panjang LRT",STL:"Sengkang LRT",PTL:"Punggol LRT"};
          const NAME_OF = {};
          for (const c of ORDER) for (const st of LINES[c].stations) NAME_OF[st[0]] = st[1];
          NAME_OF.CE1 = "Bayfront"; NAME_OF.CE2 = "Marina Bay";
          const NEWS = "https://news.google.com/rss/search?q=" +
            encodeURIComponent('(MRT OR LRT OR SMRT OR "SBS Transit" OR "train service" OR "rail line" OR "RTS Link" OR "Cross Island Line" OR "Jurong Region Line") Singapore when:7d') +
            "&hl=en-SG&gl=SG&ceid=SG:en";
          /* Keep only headlines about Singapore's trains and railways. */
          const SG_OUTLETS = /^(The Straits Times|CNA|Channel NewsAsia|TODAY|Mothership(\.sg)?|AsiaOne|The Business Times|The New Paper|Stomp|Lianhe Zaobao|8world|The Independent Singapore|Yahoo News Singapore|Land Transport Guru|SGTrains|Singapore Business Review|Vulcan Post|Berita Harian|Tamil Murasu|gov\.sg|LTA|Land Transport Authority|SMRT|SBS Transit)$/i;
          const RAIL_WORDS = /\b(MRT|LRT|SMRT|SBS Transit|trains?|rail(way)?s?|stations?|tracks?|signall?ing|lines?|commuters?|RTS)\b/i;
          const FOREIGN = /\b(Manila|Philippines?|Kuala Lumpur|KL|Klang|Penang|Jakarta|Indonesia|Bangkok|Thailand|Taipei|Taiwan|Hong Kong|MTR|Delhi|Mumbai|India|Dhaka|Karachi|Lahore|Hanoi|Ho Chi Minh|Vietnam|Sydney|Melbourne|London|Tokyo|Osaka|Seoul|Beijing|Shanghai|Shenzhen|Dubai|Riyadh|Doha|Cairo|New York|Washington|Paris)\b/i;
          const SG_STRONG = /\b(Singapore|S'pore|SMRT|SBS Transit|LTA|RTS Link)\b/i;
          const reEsc = x => x.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
          const SG_RAIL = new RegExp("\\b(Singapore|S'pore|SMRT|SBS Transit|LTA|NSL|EWL|NEL|CCL|DTL|TEL|CRL|JRL|CGL|RTS Link|" +
            "North[- ]South Line|East[- ]West Line|North East Line|Circle Line|Downtown Line|Thomson[- ]East Coast|Cross Island Line|Jurong Region Line|" +
            [...new Set(Object.values(NAME_OF))].filter(n => n.length > 4).map(reEsc).join("|") + ")\\b", "i");
          function isSgRail(n){
            const t = n.title;
            if (!RAIL_WORDS.test(t)) return false;                       // must be about trains or rail
            if (FOREIGN.test(t) && !SG_STRONG.test(t)) return false;     // other countries' railways
            return SG_RAIL.test(t) || SG_OUTLETS.test(n.source.trim());  // a Singapore line, station or outlet
          }

          const store = {
            get(k, d){ try { const v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch(e){ return d; } },
            set(k, v){ try { localStorage.setItem(k, JSON.stringify(v)); } catch(e){} }
          };
          const hhmm = d => d ? new Date(d).toLocaleTimeString("en-SG", {hour:"numeric", minute:"2-digit", timeZone:"Asia/Singapore"}) : "";

          /* state */
          let alertState = store.get("mrt.alerts", null);  // {status, segments, messages, at}
          let alertError = "";
          let newsState = store.get("mrt.news", null);      // {items, at}
          let loading = false;
          let autoRefresh = store.get("mrt.auto", true);

          /* --- native bridge --- */
          const pending = {};
          let reqId = 0;
          window.__native = (id, code, body) => { const cb = pending[id]; delete pending[id]; cb && cb(code, body); };
          function nativeGet(url, withKey){
            return new Promise(res => { const id = "r" + (++reqId); pending[id] = (code, body) => res({code, body}); APP.fetch(id, url, !!withKey); });
          }
          const hasKey = () => { try { return !!(APP && APP.hasKey()); } catch(e){ return false; } };

          /* --- parsing --- */
          function parseAlerts(body){
            const j = JSON.parse(body);
            let v = j.value ?? j;
            if (Array.isArray(v)) v = v[0] || {};
            const segs = (v.AffectedSegments || []).map(sg => {
              // Bayfront and Marina Bay were renumbered from CE1/CE2 to CC34/CC33 when the Circle Line loop opened.
              const codes = String(sg.Stations || "").split(",").map(x => x.trim()).filter(Boolean).map(c => ({CE1:"CC34", CE2:"CC33"})[c] || c);
              // Lists use "," between stations, "|" between codes of one interchange and ";" between shuttle areas.
              const list = s => String(s || "").split(/[,;]/).map(x => x.trim().split("|")[0].trim()).filter(Boolean);
              const lta = String(sg.Line || "").toUpperCase();
              const family = LINES_FROM_LTA[lta] || [];
              let lines = family.filter(c => LINES[c].stations.some(st => codes.includes(st[0])));
              if (!lines.length) lines = family.slice(0, 1);
              return {
                lines, line: lines[0] || null,
                ltaLine: lta,
                direction: sg.Direction || "",
                codes,
                bus: list(sg.FreePublicBus),
                shuttle: list(sg.FreeMRTShuttle || sg.FreeMrtShuttle),
                shuttleDir: sg.MRTShuttleDirection || ""
              };
            });
            const msgs = (v.Message || []).filter(m => m && m.Content)
              .map(m => ({text: m.Content, at: m.CreatedDate || ""}))
              .sort((a, b) => String(b.at).localeCompare(String(a.at)));
            return {status: Number(v.Status) === 2 ? 2 : 1, segments: segs, messages: msgs, at: Date.now()};
          }
          function parseNews(xml){
            const doc = new DOMParser().parseFromString(xml, "text/xml");
            return [...doc.querySelectorAll("item")].map(it => {
              const t = it.querySelector("title")?.textContent || "";
              const src = it.querySelector("source")?.textContent || "";
              return {
                title: src && t.endsWith(" - " + src) ? t.slice(0, -(src.length + 3)) : t,
                link: it.querySelector("link")?.textContent || "",
                source: src,
                date: it.querySelector("pubDate")?.textContent || ""
              };
            }).filter(n => /^https?:\/\//.test(n.link) && isSgRail(n)).slice(0, 12);
          }

          /* --- refresh --- */
          async function refreshAll(){
            if (!APP || loading) return;
            loading = true; renderUpdates();
            const jobs = [];
            if (hasKey()){
              jobs.push(nativeGet(DATAMALL, true).then(({code, body}) => {
                if (SIM.alert) return;                               // test mode is showing a fake disruption
                if (code === 200){ try { alertState = parseAlerts(body); store.set("mrt.alerts", alertState); alertError = ""; } catch(e){ alertError = "LTA sent something this app couldn't read."; } }
                else if (code === 401 || code === 403) alertError = "LTA turned down the request. Live alerts are unavailable for now.";
                else alertError = code === 0 ? "Couldn't reach LTA. Check your internet connection." : `LTA's service returned an error (${code}).`;
              }));
            }
            jobs.push(nativeGet(NEWS, false).then(({code, body}) => {
              if (code === 200){ try { newsState = {items: parseNews(body), at: Date.now()}; store.set("mrt.news", newsState); } catch(e){} }
            }));
            await Promise.all(jobs);
            loading = false;
            renderAll();
          }
          window.appResume = () => refreshAll();     // called by the app every time it is opened

          /* ---------- In-app updates ----------
             The app checks GitHub for a newer version when it opens; these show the banner and progress. */
          let updState = null;   // {version, pct, error, needPerm}
          function renderUpd(){
            const b = $("updBanner");
            if (!updState){ b.hidden = true; return; }
            b.hidden = false;
            const u = updState, busy = u.pct !== null && u.pct !== undefined && !u.error;
            const label = u.error ? "Try again" : busy ? (u.pct >= 100 ? "Installing…" : `${u.pct}%`) : "Update";
            b.innerHTML = `<div><b>New version available</b><br><span class="sub">${u.error ? esc(u.error)
                : u.needPerm ? "Allow MRT Tracker to install updates, then come back and tap Update."
                : busy ? (u.pct >= 100 ? "Confirm the update on the next screen." : "Downloading…") : `Version ${esc(u.version)}`}</span></div>
              <button class="ubtn" type="button" id="updGo"${busy ? " disabled" : ""}>${label}</button>
              ${busy ? `<div class="ubar"><i style="width:${Math.min(100, u.pct)}%"></i></div>` : ""}`;
            $("updGo").onclick = () => { updState = {version: u.version, pct: 0}; renderUpd(); APP.installUpdate(); };
          }
          window.updateAvailable = v => { if (!updState || updState.error || updState.needPerm) updState = {version: v || (updState && updState.version) || "", pct: null}; renderUpd(); };
          window.updateProgress = p => { if (!updState) updState = {version: ""}; updState.pct = p; updState.error = null; renderUpd(); };
          window.updateError = m => { updState = {...(updState || {version: ""}), pct: null, error: m || "The update couldn't be installed."}; renderUpd(); };
          window.updateNeedsPermission = () => { updState = {...(updState || {version: ""}), pct: null, needPerm: true}; renderUpd(); };
          setInterval(() => { if (APP && autoRefresh && !document.hidden) refreshAll(); }, 60000);

          /* --- rendering --- */
          const disruptedLines = () => alertState && alertState.status === 2 ? new Set(alertState.segments.flatMap(s => s.lines || [s.line]).filter(Boolean)) : new Set();
          const lineLabel = sg => LINE_NAME_LTA[sg.ltaLine] || (sg.line ? LINES[sg.line].name : sg.ltaLine);
          function segTitle(sg){
            const names = sg.codes.map(c => NAME_OF[c] || c);
            const span = names.length > 1 ? `${names[0]} to ${names[names.length-1]}` : (names[0] || "Stations not listed");
            return span;
          }
          function segHTML(sg){
            const c = sg.line;
            const pill = `<span class="code" style="background:var(--${c || "muted"})">${esc(sg.ltaLine || c)}</span>`;
            const dir = sg.direction && !/^both$/i.test(sg.direction) ? `Towards ${esc(NAME_OF[sg.direction] || sg.direction)}` : "Both directions";
            const extra = [];
            if (sg.bus.length) extra.push(sg.bus.some(x => /island/i.test(x)) ? "Free bus rides island-wide" : `Free regular buses at ${esc(sg.bus.map(x => NAME_OF[x] || x).join(", "))}`);
            if (sg.shuttle.length) extra.push(`Free bridging buses at ${esc(sg.shuttle.map(x => NAME_OF[x] || x).join(", "))}${sg.shuttleDir ? ` (${esc(sg.shuttleDir)})` : ""}`);
            return `<div class="seg"><div class="h">${pill}${esc(segTitle(sg))}</div>
              <span class="sub">${dir} · ${sg.codes.length} station${sg.codes.length === 1 ? "" : "s"} affected</span>
              ${extra.map(x => `<span class="sub">${x}</span>`).join("")}</div>`;
          }
          function msgsHTML(msgs){
            return msgs.length ? `<ul class="msgs">${msgs.map(m => `<li><span>${esc(m.text)}</span>${m.at ? `<span class="muted">${esc(m.at)}</span>` : ""}</li>`).join("")}</ul>` : "";
          }

          function renderBanner(){
            const b = $("alertBanner");
            if (!APP && !SIM.alert){ b.innerHTML = ""; return; }
            if (!hasKey() && !SIM.alert){
              b.innerHTML = `<div class="alert off"><b>Live disruption alerts aren't included in this version of the app</b></div>`;
            } else if (alertState && alertState.status === 2){
              const n = alertState.segments.length;
              const first = alertState.segments[0];
              const head = first ? `${lineLabel(first)}: ${segTitle(first)}` : "Train service disruption";
              b.innerHTML = `<button class="alert bad" type="button" id="bnGo"><b>⚠ ${esc(head)}</b>
                <span class="sub">${n > 1 ? `${n - 1} more affected stretch${n > 2 ? "es" : ""} · ` : ""}Tap for details · updated ${hhmm(alertState.at)}</span></button>`;
            } else if (alertState && alertState.segments.length){
              b.innerHTML = `<button class="alert warn" type="button" id="bnGo"><b>Train service has resumed on the ${esc(lineLabel(alertState.segments[0]))}</b>
                <span class="sub">Free bus rides are still available · tap for details · updated ${hhmm(alertState.at)}</span></button>`;
            } else if (alertState){
              b.innerHTML = `<div class="alert ok"><b>All train services running normally</b><span class="sub">LTA status · updated ${hhmm(alertState.at)}${loading ? " · refreshing…" : ""}</span></div>`;
            } else {
              b.innerHTML = `<div class="alert off"><b>${loading ? "Checking train service status…" : "Train service status not loaded yet"}</b>${alertError ? `<span class="sub">${esc(alertError)}</span>` : ""}</div>`;
            }
            const go = $("bnGo"); if (go) go.onclick = () => showView("updates", "officialCard");
          }

          function renderOfficial(){
            const el = $("officialCard"), refreshBtn = `<button class="btn ghost" type="button" id="refreshBtn"${loading ? " disabled" : ""}>${loading ? "Refreshing…" : "Refresh now"}</button>`;
            let body;
            if (!APP){
              const sample = {segments:[{lines:["NSL"],line:"NSL",ltaLine:"NSL",direction:"Both",codes:["NS1","NS2","NS3","NS4"],bus:["NS1","NS2","NS3","NS4"],shuttle:[],shuttleDir:""}],
                messages:[{text:"0712hrs: NSL – No train service between Jurong East and Choa Chu Kang due to a track fault. Free regular bus services are available at designated bus stops near the affected stations.", at:"Example"}]};
              body = `<p class="muted">Live notices from LTA's official alerts feed appear here in your MRT Tracker phone app. Here's how a disruption looks:</p>
                <div class="alert bad" style="cursor:default"><span><span class="chip sample">Sample</span></span>${sample.segments.map(segHTML).join("")}</div>${msgsHTML(sample.messages)}`;
            } else if (!hasKey()){
              body = `<p class="muted">Live disruption alerts aren't included in this version of the app.</p>`;
            } else if (alertState && alertState.status === 2){
              body = `<div style="display:grid;gap:10px">${alertState.segments.map(segHTML).join("")}</div>
                ${alertState.messages.length ? `<h2 style="font-size:16px;margin-top:6px">Announcements</h2>${msgsHTML(alertState.messages)}` : ""}`;
            } else if (alertState && alertState.segments.length){
              body = `<p><b style="color:var(--good)">Train service has resumed.</b> Free rides are still available on these stretches:</p>
                <div style="display:grid;gap:10px">${alertState.segments.map(segHTML).join("")}</div>${msgsHTML(alertState.messages)}`;
            } else if (alertState){
              body = `<p><b style="color:var(--good)">All train services are running normally.</b></p>${msgsHTML(alertState.messages)}`;
            } else body = `<p class="muted">${loading ? "Loading…" : "No status yet."}</p>`;
            const meta = APP && hasKey() ? `<p class="muted">${alertState ? `Updated ${hhmm(alertState.at)}` : ""}${alertError ? ` · ${esc(alertError)}` : ""}</p>` : "";
            el.innerHTML = `<h2>LTA service status</h2><div style="display:grid;gap:10px">${body}${meta}<p class="muted">Source: Land Transport Authority (LTA), datamall.lta.gov.sg</p>${APP && hasKey() ? `<div>${refreshBtn}</div>` : ""}</div>`;
            const r = $("refreshBtn"); if (r) r.onclick = refreshAll;
          }

          function renderNews(){
            const list = $("newsList"), note = $("newsNote");
            if (!APP){ note.textContent = "News about Singapore's MRT, LRT and rail appears here in your MRT Tracker phone app."; list.innerHTML = ""; return; }
            if (!newsState || !newsState.items.length){
              note.textContent = loading ? "Loading recent reports…" : "No Singapore rail news from the past week.";
              list.innerHTML = ""; return;
            }
            note.textContent = `Headlines from the past week. Source: Google News (news.google.com) · updated ${hhmm(newsState.at)}`;
            list.innerHTML = newsState.items.map(n => {
              const d = n.date ? new Date(n.date) : null;
              const when = d && !isNaN(d) ? d.toLocaleDateString("en-SG", {day:"numeric", month:"short", timeZone:"Asia/Singapore"}) + ", " + hhmm(d) : "";
              return `<li><a href="${esc(n.link)}" target="_blank" rel="noopener">${esc(n.title)}</a><span class="muted">${esc(n.source)}${n.source && when ? " · " : ""}${esc(when)}</span></li>`;
            }).join("");
          }

          function renderSettings(){
            const el = $("settingsCard");
            if (!APP){ el.hidden = true; return; }
            const k = hasKey();
            el.innerHTML = `<h2>Settings</h2><div class="set">
              <label>Live disruption alerts</label>
              <p class="muted">${k ? `<b style="color:var(--good)">✓ Included.</b> Alerts come straight from LTA.` : "Not included in this version of the app."}</p>
              <label class="toggle"><input type="checkbox" id="autoIn"${autoRefresh ? " checked" : ""}> Refresh every minute while the app is open</label>
              ${k && APP.downloadTimetable ? `<label>Official train timetable</label>
              <p class="muted">Downloads LTA's timetable file (GTFS Schedule) to your Downloads folder, so you can send it to Claude.</p>
              <div><button class="btn ghost" type="button" id="ttBtn">Download LTA timetable</button></div>
              <div id="ttOut" class="muted"></div>` : ""}
              <p class="muted" id="setMsg"></p>
              <label>Train times</label>
              <p class="muted">${TT ? `<b style="color:var(--good)">✓ LTA official timetable</b>, downloaded ${esc(TT.feed.built)}. ${TT.feed.lines.length < ORDER.length ? `Estimated on: ${ORDER.filter(c => !TT.lines[c]).map(c => c === "CG" ? "CGL" : c).join(", ")}.` : "Covers every line."}` : "Estimated from typical frequencies. This version of the app doesn't include LTA's timetable."}</p>
              ${APP.getVersion ? `<label>App version</label>
              <p class="muted"><b>${esc(APP.getVersion())}</b> · ${APP_CHANNEL === "dev" ? "MRT Dev, the developer app for trying new features. It updates separately from MRT Tracker." : "MRT Tracker (beta)"}</p>` : ""}
              ${APP.checkUpdateNow ? `<div><button class="btn ghost" type="button" id="updCheck">Check for updates</button></div><p class="muted" id="updMsg"></p>` : ""}</div>`;

            const uc = $("updCheck");
            if (uc) uc.onclick = () => {
              uc.disabled = true; $("updMsg").textContent = "Checking…";
              const id = "u" + (++reqId);
              pending[id] = (code, body) => {
                uc.disabled = false;
                let r = {}; try { r = JSON.parse(body); } catch(e){}
                if (r.enabled === false) $("updMsg").textContent = "Automatic updates aren't set up for this version of the app.";
                else if (r.available){ $("updMsg").textContent = `Version ${r.version} is available.`; updateAvailable(r.version); }
                else $("updMsg").textContent = "You have the latest version.";
              };
              APP.checkUpdateNow(id);
            };
            $("autoIn").onchange = e => { autoRefresh = e.target.checked; store.set("mrt.auto", autoRefresh); };
            const tt = $("ttBtn");
            if (tt) tt.onclick = () => {
              tt.disabled = true; tt.textContent = "Downloading…";
              $("ttOut").textContent = "Asking LTA for the timetable. This can take up to a minute.";
              const id = "t" + (++reqId);
              pending[id] = (code, body) => {
                tt.disabled = false; tt.textContent = "Download LTA timetable";
                let r = {}; try { r = JSON.parse(body); } catch(e){}
                if (r.error || code !== 200){
                  $("ttOut").innerHTML = `<b style="color:var(--bad)">Download failed.</b> ${code === 401 || code === 403 ? "LTA turned down the request." : esc(r.error || "Couldn't reach LTA.")}`;
                  return;
                }
                const mb = (r.size / 1048576).toFixed(1);
                $("ttOut").innerHTML = `<b style="color:var(--good)">Done.</b> ${r.saved ? `Saved to <b>${esc(r.saved)}</b> (${mb} MB). Attach that file in your chat with Claude.` : `Downloaded ${mb} MB, but saving to Downloads needs Android 10 or newer. Screenshot the summary below instead.`}
                  <pre style="font:12px/1.45 var(--mono);white-space:pre-wrap;word-break:break-all;background:var(--soft);color:var(--fg);padding:10px;border-radius:8px;margin-top:8px;max-height:340px;overflow:auto">${esc((r.files || []).map(f => `${f.name} · ${f.lines} lines\n  ${f.head.join("\n  ")}`).join("\n\n"))}</pre>`;
              };
              APP.downloadTimetable(id);
            };
          }

          function renderAll(){
            renderBanner(); renderOfficial(); renderNews(); renderSettings();
            const dl = disruptedLines();
            const badge = $("vBadge");
            badge.hidden = !dl.size; badge.textContent = alertState ? alertState.segments.length : "";
            window.afterTabs();
          }
          function renderUpdates(){ renderBanner(); renderOfficial(); renderNews(); }

          /* marks on line tabs and station rows */
          window.afterTabs = () => {
            const dl = disruptedLines();
            document.querySelectorAll(".tab").forEach(t => t.classList.toggle("dis", dl.has(t.dataset.c)));
          };
          window.afterTick = () => {
            const hit = new Set();
            if (alertState && alertState.status === 2) for (const sg of alertState.segments) if ((sg.lines || [sg.line]).includes(current)) sg.codes.forEach(c => hit.add(c));
            const L = LINES[current];
            document.querySelectorAll("#board .row").forEach(r => r.classList.toggle("dis", hit.has(L.stations[+r.dataset.i][0])));
          };


          /* --- Theme Toggle --- */
          let curTheme = store.get("mrt.theme", "");
          function applyTheme(t){
            curTheme = t;
            if (t) document.documentElement.setAttribute("data-theme", t);
            else document.documentElement.removeAttribute("data-theme");
            store.set("mrt.theme", t);
            $("themeBtn").textContent = t === "dark" ? "🌙" : t === "light" ? "☀️" : "◐";
