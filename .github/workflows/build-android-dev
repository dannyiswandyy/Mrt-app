              @Override
              protected void onResume() {
                  super.onResume();
                  current = new java.lang.ref.WeakReference<>(this);
                  web.onResume();
                  if (pageLoaded) checkForUpdate();
                  // Fresh status every time the app is opened or brought back to the front.
                  if (pageLoaded) {
