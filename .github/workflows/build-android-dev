          .train:focus-visible{outline:2px solid var(--fg);outline-offset:1px;border-radius:6px}
          .train.d1{left:40px}
          .train.d0{left:3px}
          .tinfo{display:flex;align-items:center;gap:10px;background:var(--panel);border:1px solid var(--rule);border-radius:10px;padding:10px 12px;margin-top:8px;font-size:14px;border-left:6px solid var(--c)}
          .tinfo b{font-weight:600}
          .tinfo .eta{margin-left:auto;font-family:var(--mono);font-variant-numeric:tabular-nums;white-space:nowrap}
          .tinfo button{border:0;background:none;color:var(--muted);font-size:18px;cursor:pointer;padding:0 2px}
          .tinfo .tic{width:18px;height:22px;display:block}

          .tview{display:inline-flex;gap:2px;background:var(--soft);border-radius:8px;padding:2px;margin-bottom:8px}
          .tview button{border:0;background:none;color:var(--muted);font:600 13px var(--body);padding:5px 14px;border-radius:6px;cursor:pointer}
          .tview button[aria-selected="true"]{background:var(--panel);color:var(--fg);box-shadow:0 1px 2px rgba(0,0,0,.12)}

          /* MAP VIEW & OVERLAYS */
          #mapView{position:relative;display:flex;flex-direction:column}
          .mapwrap{position:relative;height:calc(100vh - 210px);min-height:420px;border-radius:12px;overflow:hidden;background:var(--panel);border:1px solid var(--rule)}
          .mapwrap canvas{display:block;width:100%;height:100%;touch-action:none;cursor:grab}
          .mapwrap canvas:active{cursor:grabbing}
          .mapcount{position:absolute;left:10px;top:10px;font-size:12px;font-weight:500;color:var(--muted);background:var(--panel);border:1px solid var(--rule);border-radius:8px;padding:4px 9px;pointer-events:none;opacity:.94;box-shadow:0 2px 8px rgba(0,0,0,.12)}
          .mapctl{position:absolute;right:10px;top:10px;display:grid;gap:6px}
          .cwd{display:inline-flex;align-items:center;gap:3px;font:600 10.5px var(--body);letter-spacing:.02em;border-radius:10px;padding:1px 7px 1px 5px;vertical-align:middle;white-space:nowrap;line-height:1.5}
          .cwd svg{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round}
          .cwd.l{background:var(--goodbg);color:var(--good)} .cwd.m{background:var(--warnbg);color:var(--warn)} .cwd.h{background:var(--badbg);color:var(--bad)}
          .cwd-slot:not(:empty){margin-left:4px}
          .cw-note{font-size:12.5px;color:var(--muted);margin:0 0 8px;display:flex;flex-wrap:wrap;gap:4px;align-items:center}
          .mi-crowd{display:flex;flex-wrap:wrap;gap:4px;align-items:center;font-size:12.5px;color:var(--muted);margin:2px 0 8px}
          .mi-crowd .code{margin-right:2px}
          .mapcrowd{position:absolute;left:10px;top:46px;display:flex;align-items:center;gap:6px;border:1px solid var(--rule);background:var(--panel);color:var(--fg);border-radius:9px;padding:5px 10px;font:600 12.5px var(--body);cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.12)}
          .mapcrowd svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round}
          .mapcrowd[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
          .mapcrowd .k{display:none;gap:5px;font-weight:500}
          .mapcrowd[aria-pressed="true"] .k{display:inline-flex}
          .mapcrowd .k i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:2px;vertical-align:0}
          .maplayer{position:absolute;left:10px;bottom:10px;display:flex;gap:2px;background:var(--panel);border:1px solid var(--rule);border-radius:9px;padding:2px;box-shadow:0 2px 8px rgba(0,0,0,.12)}
          .maplayer button{border:0;background:none;color:var(--muted);font:600 12.5px var(--body);padding:6px 11px;border-radius:7px;cursor:pointer}
          .maplayer button[aria-pressed="true"]{background:var(--fg);color:var(--bg)}
          /* TEST MODE (MRT Dev) */
          button.devtag{border:0;cursor:pointer;display:inline-flex;align-items:center;gap:4px}
          .devtag svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
          .simbar{background:#c2410c;color:#fff;border-radius:10px;padding:7px 8px 7px 12px;margin:0 0 8px;display:flex;align-items:center;gap:6px;font-size:13px;line-height:1.35;flex-wrap:wrap}
          .simbar span{flex:1;min-width:170px}
          .simbar button{border:1px solid rgba(255,255,255,.65);background:transparent;color:#fff;border-radius:8px;padding:5px 10px;font:600 12.5px var(--body);cursor:pointer}
          .simbar[hidden],.simsheet[hidden],.simsheet-bg[hidden]{display:none}
          .simsheet-bg{position:fixed;inset:0;z-index:80;background:rgba(0,0,0,.45)}
          .simsheet{position:fixed;left:0;right:0;bottom:0;z-index:81;max-height:86vh;overflow-y:auto;overscroll-behavior:contain;background:var(--panel);color:var(--fg);border-radius:16px 16px 0 0;border-top:6px solid #c2410c;padding:14px 16px calc(18px + env(safe-area-inset-bottom,0px));display:grid;gap:14px;align-content:start;box-shadow:0 -8px 30px rgba(0,0,0,.3);outline:none}
          .simsheet .sim-h{display:flex;justify-content:space-between;align-items:center;gap:8px}
          .simsheet h2{font:700 22px/1.1 var(--display);text-transform:uppercase;letter-spacing:.02em;margin:0}
          .simsheet .sim-h button{width:40px;height:40px;border-radius:20px;border:0;background:var(--soft);color:var(--fg);font-size:20px;cursor:pointer}
          .simsheet h3{font:600 12px var(--body);letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin:0 0 6px}
          .simsheet p{margin:0;font-size:13px;color:var(--muted);line-height:1.45}
          .simsheet section{min-width:0}
          .sim-row{display:flex;flex-wrap:wrap;gap:6px}
          .sim-row .hchip[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
          .sim-row .hchip small{font-weight:500;opacity:.7}
          .sim-at{display:flex;gap:6px;margin-top:8px}
          .sim-at input{flex:1;min-width:0;font:500 15px var(--body);padding:8px 10px;border-radius:8px;border:1px solid var(--rule);background:var(--bg);color:var(--fg)}
          .simsheet > .btn{justify-self:start}
          @media (min-width:1024px){ .simsheet{left:auto;top:0;bottom:0;width:440px;max-height:none;border-radius:0;border-top:0;border-left:6px solid #c2410c} }
          /* WEATHER (map chip, card and station line) */
          .mapwx{position:absolute;left:10px;bottom:52px;display:flex;align-items:center;gap:6px;max-width:calc(100% - 20px);border:1px solid var(--rule);background:var(--panel);color:var(--fg);border-radius:9px;padding:5px 10px;font:600 12.5px var(--body);cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.12)}
          .mapwx[hidden],.wxcard[hidden]{display:none}
          .mapwx svg,.mi-wx svg{width:16px;height:16px;flex:0 0 auto;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
          .mapwx .wa{font-weight:500;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
          .mapwx[aria-expanded="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
          .mapwx[aria-expanded="true"] .wa{color:inherit;opacity:.75}
          .wxcard{position:absolute;left:10px;bottom:92px;width:min(320px,calc(100% - 20px));background:var(--panel);color:var(--fg);border:1px solid var(--rule);border-radius:12px;padding:10px 12px;box-shadow:var(--shadow);font-size:13.5px;display:grid;gap:5px;z-index:3}
          .wxcard p{margin:0;line-height:1.4}
          .wxcard .wx-h{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:15px}
          .wxcard .btn{justify-self:start;padding:6px 10px;font-size:12.5px;margin-top:2px}
          .wxcard .wx-src{font-size:11px;color:var(--muted)}
          .mi-wx{display:flex;gap:6px;align-items:flex-start;font-size:12.5px;color:var(--muted);margin:0 0 6px}
          .mapattr{position:absolute;right:8px;bottom:6px;max-width:52%;text-align:right;font-size:10px;line-height:1.25;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.9),0 0 4px rgba(0,0,0,.6);pointer-events:none}
          .mapctl button{width:38px;height:38px;border-radius:9px;border:1px solid var(--rule);background:var(--panel);color:var(--fg);font:600 18px var(--body);cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,.15)}
          .mapctl button:hover{background:var(--soft)}
          .mapctl button.m3d{font-size:13px;letter-spacing:.02em}
          .mapctl button.m3d[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
          .mapctl button[hidden]{display:none}
          .mapinfo{background:var(--panel);border:1px solid var(--rule);border-radius:12px;padding:12px 14px;margin-top:8px;display:grid;gap:6px;font-size:14px;box-shadow:var(--shadow)}
          .mi-h{display:flex;align-items:center;gap:8px}
          .mi-h b{font-size:16px}
          .mi-x{margin-left:auto;border:0;background:none;color:var(--muted);font-size:20px;cursor:pointer;padding:0 4px}
          .mi-row{display:flex;justify-content:space-between;align-items:center;gap:10px;font:inherit;color:var(--fg);background:none;border:0;padding:6px 4px;text-align:left;width:100%;border-radius:6px}
          .mi-go{cursor:pointer;border-top:1px solid var(--soft)}
          .mi-go:hover{background:var(--soft)}
          .mi-go span:first-child{display:flex;align-items:center;gap:6px;min-width:0}
          .mi-t{font-family:var(--mono);font-size:13px;font-variant-numeric:tabular-nums;white-space:nowrap;color:var(--muted)}
          .mi-act{display:flex;gap:8px;flex-wrap:wrap;margin-top:2px}
          .hint{color:var(--muted);font-size:13px;margin:6px 0 0}
          @media (prefers-reduced-motion:reduce){.train::before,.train.dwell .tic,.live{animation:none}}

          /* STATION ROWS */
          .row{position:relative;min-height:var(--rowh);display:grid;grid-template-columns:64px 1fr;align-items:center;cursor:pointer;border-top:1px solid var(--soft)}
          .row:first-of-type{border-top:0}
          .row:hover{background:color-mix(in srgb,var(--soft) 50%,transparent)}
          .row .dot{position:absolute;left:24px;top:calc(var(--rowh)/2 - 8px);width:16px;height:16px;border-radius:50%;background:var(--panel);border:4px solid var(--c);z-index:1}
          .row.ix .dot{border-color:var(--fg);border-width:3px;width:18px;height:18px;left:23px;top:calc(var(--rowh)/2 - 9px)}
          .row.future .dot{border-color:var(--track)}
          .st{grid-column:2;display:grid;grid-template-columns:1fr auto;gap:2px 10px;padding:7px 12px 7px 4px;min-width:0}
          .name{display:flex;align-items:center;gap:6px;flex-wrap:wrap;min-width:0;font-weight:600;font-size:15.5px}
          .code{font-family:var(--display);font-weight:700;font-size:13px;color:#fff;background:var(--c);border-radius:4px;padding:1px 5px;letter-spacing:.03em;line-height:1.25}
          .code.sm{font-size:11px;padding:0 4px}
          .row.future .name{color:var(--muted)}
          .next{font-family:var(--mono);font-size:13px;font-variant-numeric:tabular-nums;text-align:right;color:var(--muted);white-space:nowrap;display:grid;gap:1px;align-self:center}
          .next em{font-style:normal;color:var(--fg);font-weight:600}
          .detail{grid-column:1/-1;font-size:13px;color:var(--muted);display:grid;gap:4px;padding-top:6px;margin-top:4px;border-top:1px dashed var(--rule)}
          .detail div{display:flex;justify-content:space-between;gap:2px 10px;flex-wrap:wrap}
          .detail .t{font-family:var(--mono);color:var(--fg);font-variant-numeric:tabular-nums;white-space:nowrap;margin-left:auto}
          /* special-bound trains: ones that end partway along the line */
          .sb{font:600 11px var(--body);color:var(--fg);background:var(--panel);border:1px solid var(--rule);border-radius:4px;padding:0 4px;margin-left:4px;white-space:nowrap;vertical-align:1px}
          .next .sbc,.mi-t .sbc{font:700 10px var(--display);font-style:normal;color:var(--fg);margin-left:3px;letter-spacing:.02em}
          .detail .sbnote{margin:0;font-size:11.5px;line-height:1.35}
          .train.short .tic .body{stroke:var(--fg);stroke-width:1.6;stroke-dasharray:3 2}
          .row.open{background:var(--soft)}

          /* ALERTS & UPDATES */
          .tab.dis::after{content:"";width:8px;height:8px;border-radius:50%;background:var(--bad);margin-left:2px}
          .alert{border-radius:10px;padding:10px 14px;margin-bottom:8px;display:grid;gap:4px;font-size:14px;cursor:pointer;border:1px solid var(--rule);text-align:left;width:100%;font-family:var(--body);color:var(--fg)}
          .alert.ok{background:var(--goodbg);border-color:color-mix(in srgb,var(--good) 30%,transparent);cursor:default}
          .alert.ok b{color:var(--good)}
          .alert.bad{background:var(--badbg);border-left:6px solid var(--bad)}
          .alert.bad b{color:var(--bad)}
          .alert.off{background:var(--panel)}
          #updBanner{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:var(--fg);color:var(--bg);border-radius:10px;padding:10px 12px;margin-bottom:8px;font-size:14px}
          #updBanner b{font-weight:600}
          #updBanner .sub{opacity:.8;font-size:13px}
          #updBanner .ubtn{margin-left:auto;border:0;border-radius:8px;padding:8px 14px;font:600 14px var(--body);background:var(--bg);color:var(--fg);cursor:pointer}
          #updBanner .ubtn:disabled{opacity:.6;cursor:default}
          #updBanner .ubar{flex-basis:100%;height:4px;border-radius:2px;background:color-mix(in srgb,var(--bg) 30%,transparent);overflow:hidden}
          #updBanner .ubar i{display:block;height:100%;background:var(--bg);width:0}
          .alert.warn{background:var(--warnbg);border-left:6px solid var(--warn)}
          .alert.warn b{color:var(--warn)}
          .alert .sub{color:var(--muted);font-size:13px}
          .seg{display:grid;gap:3px}
          .seg .h{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-weight:600}
          .chip{font:600 11px var(--body);letter-spacing:.04em;text-transform:uppercase;border-radius:4px;padding:1px 6px;background:var(--bad);color:#fff}
          .chip.sample{background:var(--muted)}
          .row.dis .name::after{content:"Disrupted";font:600 10px var(--body);letter-spacing:.05em;text-transform:uppercase;color:#fff;background:var(--bad);border-radius:3px;padding:1px 5px}
          .upd{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px;margin-top:8px;align-items:start}
          .card{background:var(--panel);border:1px solid var(--rule);border-radius:12px;padding:16px}
          .card h2{font-family:var(--display);font-size:20px;margin:0 0 8px;letter-spacing:.01em}
          .card p{margin:0}
          .card .muted,.muted{color:var(--muted);font-size:13px}
          .msgs,.news{list-style:none;margin:0;padding:0;display:grid;gap:10px}
          .msgs li{border-left:3px solid var(--bad);padding-left:10px;display:grid;gap:2px;max-width:65ch}
          .news a{color:var(--fg);text-decoration:none;font-weight:600;display:block}
          .news a:hover{text-decoration:underline}
          .news li{display:grid;gap:2px;padding-bottom:10px;border-bottom:1px solid var(--soft)}
          .news li:last-child{border-bottom:0;padding-bottom:0}
          .links{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px}
          .links a{display:grid;gap:1px;padding:10px 12px;border-radius:8px;background:var(--soft);color:var(--fg);text-decoration:none;font-weight:600;font-size:14px}
          .links a span{font-weight:400;font-size:12px;color:var(--muted)}
          .set{display:grid;gap:10px}
          .set label{font-weight:600;font-size:14px}
          .set .rowi{display:flex;gap:8px}
          .set input[type=password],.set input[type=text]{flex:1;min-width:0;font:500 15px var(--mono);padding:9px 12px;border-radius:8px;border:1px solid var(--rule);background:var(--bg);color:var(--fg)}
          .btn{border:0;border-radius:8px;padding:9px 14px;font:600 14px var(--body);background:var(--fg);color:var(--bg);cursor:pointer}
          .btn.ghost{background:var(--soft);color:var(--fg)}
          .toggle{display:flex;align-items:center;gap:10px;font-size:14px}
          .toggle input{width:20px;height:20px;accent-color:var(--fg)}
          footer{color:var(--muted);font-size:12.5px;margin-top:20px;display:grid;gap:6px;border-top:1px solid var(--rule);padding-top:14px}
          footer b{color:var(--fg)}

          /* MOBILE BOTTOM NAVIGATION BAR */
          .mob-nav{
            position:fixed;left:0;right:0;bottom:0;z-index:50;background:var(--panel);border-top:1px solid var(--rule);
            display:grid;grid-template-columns:repeat(6,1fr);padding:4px 4px calc(4px + env(safe-area-inset-bottom,0px));
            box-shadow:0 -4px 16px rgba(0,0,0,.12);
          }
          .mob-nav button{
            border:0;background:none;color:var(--muted);font:600 11px var(--body);padding:6px 2px;border-radius:8px;
            display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;position:relative;white-space:nowrap;min-width:0;
          }
          @media (max-width:340px){ .mob-nav button{font-size:10px;letter-spacing:-.01em} }
          .mob-nav button svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
          .mob-nav button[aria-selected="true"]{color:var(--fg);background:var(--soft)}
          .mob-nav .m-badge{position:absolute;top:2px;right:calc(50% - 22px);min-width:16px;height:16px;border-radius:8px;background:var(--bad);color:#fff;font-size:10px;display:grid;place-items:center;padding:0 4px}

          /* PC / WIDE TABLET SPLIT-SCREEN OVERHAUL (>= 1024px) */
          @media (min-width: 1024px){
            body{overflow:hidden;height:100vh}
            .wrap{height:100vh;display:flex;flex-direction:column;padding:0 18px 10px}
            .mob-nav,.tview{display:none!important}
            #tabs:not([hidden]){display:flex!important}
            #viewTrains:not([hidden]){
              flex:1;min-height:0;display:grid;grid-template-columns:1.35fr 1fr;gap:16px;align-items:stretch;
            }
            #mapView,#lineView{display:flex!important;flex-direction:column;min-height:0;height:100%}
            .mapwrap{flex:1;height:auto!important;min-height:0}
            #mapInfo{position:absolute;left:12px;bottom:12px;width:min(420px,calc(100% - 24px));margin:0;z-index:10;backdrop-filter:blur(10px);background:color-mix(in srgb,var(--panel) 92%,transparent)}
            #lineView{overflow-y:auto;padding-right:4px;scrollbar-width:thin}
            #viewUpdates:not([hidden]),#viewHist:not([hidden]){flex:1;overflow-y:auto;padding-bottom:24px}
            footer{display:none}
          }

          /* HISTORY TAB */
          .hist{display:grid;gap:12px;max-width:900px;margin:8px auto 0;min-width:0}
          .hist .card{min-width:0}
          .hl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,230px),1fr));gap:8px}
          .hl{display:grid;grid-template-columns:8px 1fr;gap:1px 10px;text-align:left;border:1px solid var(--rule);border-radius:10px;background:var(--panel);color:var(--fg);padding:10px 12px;font:inherit;cursor:pointer}
          .hl:hover,.hs:hover,.hchip:hover,.otd-list button:hover{background:var(--soft)}
          .hl i{grid-row:span 2;border-radius:4px;background:var(--c)}
          .hl b{font-weight:600;font-size:15px}
          .hl span{font-size:12.5px;color:var(--muted)}
          .hm-list{display:grid;gap:12px}
          .hm h3{font:700 15px var(--display);letter-spacing:.03em;text-transform:uppercase;margin:0 0 6px;display:flex;align-items:center;gap:6px}
          .hm h3 i{width:10px;height:10px;border-radius:3px;background:var(--c)}
          .hchips{display:flex;flex-wrap:wrap;gap:6px}
          .hchip{border:1px solid var(--rule);background:var(--panel);color:var(--fg);border-radius:8px;padding:6px 10px;font:600 13px var(--body);cursor:pointer;display:inline-flex;align-items:center;gap:6px;text-align:left}
          .hchip.old{color:var(--muted);border-style:dashed}
          .hfind{width:100%;font:500 15px var(--body);padding:10px 12px;border-radius:8px;border:1px solid var(--rule);background:var(--bg);color:var(--fg)}
          .hs-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,250px),1fr));column-gap:16px;margin-top:8px}
          .hs{display:flex;align-items:center;justify-content:space-between;gap:8px;border:0;border-bottom:1px solid var(--soft);background:none;color:var(--fg);padding:9px 4px;font:500 14.5px var(--body);text-align:left;cursor:pointer;min-width:0}
          .hs .codes{display:flex;gap:3px;flex-wrap:wrap;justify-content:flex-end}
          .otd{border-left:6px solid var(--NSL)}
          .otd-list{list-style:none;margin:0;padding:0;display:grid;gap:6px}
          .otd-list button{display:grid;gap:2px;width:100%;text-align:left;border:0;background:none;color:var(--fg);font:inherit;padding:6px;margin:0 -6px;border-radius:8px;cursor:pointer}
          .otd-list .y{font:600 12px var(--mono);color:var(--muted)}
          .otd-list b{font-weight:600;font-size:15px}
          /* HISTORY CARD (bottom sheet on phones, side panel on wide screens) */
          .sheet-bg{position:fixed;inset:0;z-index:70;background:rgba(0,0,0,.45)}
          .sheet{position:fixed;left:0;right:0;bottom:0;z-index:71;max-height:88vh;display:flex;flex-direction:column;background:var(--panel);color:var(--fg);
