            const isLine = !isUpd && !isHist && !isAsk && !isCam && !isMap;
            $("mbAsk").setAttribute("aria-selected", isAsk);
            $("mbCam").setAttribute("aria-selected", isCam);
            $("mbMap").setAttribute("aria-selected", isMap);
            $("mbLine").setAttribute("aria-selected", isLine);
            $("mbHist").setAttribute("aria-selected", isHist);
            $("mbUpdates").setAttribute("aria-selected", isUpd);
            const b = $("vBadge"), mb = $("mbBadge");
            if (b && mb){ mb.hidden = b.hidden; mb.textContent = b.textContent; }
