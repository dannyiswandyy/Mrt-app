                      if len(line) < 2:
                          why = f"relation {r['id']} has no track"
                          continue
                      got, why = cut(line, lines[code])
                      if got is None:
                          got, why2 = cut(line[::-1], lines[code])      # the route the other way round
                          why = why if got is None else why2
                      if got is not None:
